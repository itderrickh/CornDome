@page
@model CornDome.Pages.Play.BoardModel
@{
    ViewData["Title"] = "Play Board";
}

<div class="play-board">
    <div class="play-board-header">
        <div>
            <h1><i class="bi bi-controller"></i> Public Play Board</h1>
            <p class="text-muted mb-0">Find players and coordinate your next game.</p>
        </div>

        <div class="discord-profile">
            <div class="discord-profile-info">
                <span class="text-muted small">Connected as</span>
                <strong>#@Model.DiscordConnection.Username</strong>
            </div>
            <img src="@Model.DiscordConnection.AvatarUrl" class="avatar" alt="Discord avatar" />
        </div>
    </div>

    @if (!Model.AmIOnTheBoard)
    {
        <div class="join-board-notice">
            <div class="notice-icon">
                <i class="bi bi-person-plus"></i>
            </div>
            <div class="flex-grow-1">
                <strong>Looking for a game?</strong>
                <p class="mb-0 text-muted">Set up your preferences to let other players know you're available.</p>
            </div>
            <a asp-page="/Play/Settings" class="btn btn-primary">
                Setup Preferences <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    }

    @if (Model.IsUserInServer)
    {
        <div class="board-container">
            <div class="board-title">
                <div>
                    <h4><i class="bi bi-people"></i> Available Players</h4>
                    <span class="text-muted small">
                        @Model.Board.PlayPreferences.Count player(s) on the board
                    </span>
                </div>
                <span class="player-count">
                    <i class="bi bi-circle-fill"></i> Public Board
                </span>
            </div>

            
            <div class="table-responsive">
                <table class="table play-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Discord User (Address them as)</th>
                            <th>Pronouns</th>
                            <th>Game Format</th>
                            <th>Availability</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Board.PlayPreferences.Count == 0)
                        {
                            <tr>
                                <td colspan="4">
                                    <div class="empty-board">
                                        <i class="bi bi-controller"></i>
                                        <strong>No players yet</strong>
                                        <span class="text-muted">Be the first to sign up!</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Board.PlayPreferences)
                            {
                                <tr>
                                    <td data-label="Discord User">
                                        <strong>
                                            @Model.Board.UserTable[item.UserId].Username
                                            @if (!string.IsNullOrEmpty(item.AddressMeAs))
                                            {
                                                <span>(@item.AddressMeAs)</span>
                                            }
                                        </strong>
                                    </td>
                                    <td data-label="Pronouns">
                                        @if (!string.IsNullOrEmpty(item.Pronouns))
                                        {
                                            <span class="pronoun-badge">@item.Pronouns</span>
                                        }
                                    </td>
                                    <td data-label="Game Format">
                                        <span class="format-badge">@item.GameFormat</span>
                                    </td>
                                    <td data-label="Availability">
                                        <div class="availability-list">
                                            <div class="availability-item">
                                                <span class="availability-tz">Timezone</span>
                                                <span>@item.TimeZone</span>
                                            </div>
                                            @foreach (var avail in Model.Board.Availability[item.UserId])
                                            {
                                                <div class="availability-item">
                                                    <span class="availability-day">@avail.Day</span>
                                                    <span>@avail.StartTime - @avail.EndTime</span>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    }
    else
    {
        <div class="discord-join-card">
            <i class="bi bi-discord"></i>
            <h4>Join the Card Wars Discord</h4>
            <p class="text-muted">You need to be a member of the Card Wars Discord server to view the public play board.</p>
            <a href="https://discord.gg/k6AdsejJYD" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                <img alt="" src="~/img/discord.png" />
                Join Discord Server
                <i class="bi bi-box-arrow-up-right"></i>
            </a>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/play/board.css" asp-append-version="true" />
}
