@page
@model CornDome.Pages.Resources.ApiDocumentationModel
@{
    ViewData["Title"] = "API Documentation";
}

<div class="container py-4">
    <h1 class="mb-3">CardDweeb API</h1>

    <p class="lead">
        The CardDweeb API allows developers to retrieve card data, deck data and
        related information from the CardDweeb database.
        Use it to build tools, websites, applications, and other integrations.
    </p>

    <hr />

    <h2>Base URL</h2>
    <p>All API endpoints use the following base URL:</p>

    <pre class="bg-body-tertiary border rounded p-3"><code>https://www.carddweeb.com/api</code></pre>

    <h2 class="mt-4">Requirements</h2>
    <p>
        Every request must include a non-empty <code>User-Agent</code>
        header identifying the client making the request. Requests without
        this header will be rejected.
    </p>

    <p>We recommend identifying your application by name and version:</p>

    <pre class="bg-body-tertiary border rounded p-3"><code>User-Agent: MyCardApp/1.0</code></pre>

    <div class="alert alert-info" role="alert">
        The User-Agent identifies your client but is not an authentication
        mechanism. It can be supplied or changed by the client.
    </div>

    <h2 class="mt-4">Endpoints</h2>

    <div class="card mb-3">
        <div class="card-body">
            <h3 class="h5">
                <span class="badge text-bg-success me-2">GET</span>
                <code>/api/cards</code>
            </h3>
            <p>
                Returns a paginated list of cards, including available card
                data and related information.
            </p>

            <h4 class="h6">Query parameters</h4>
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">Parameter</th>
                            <th scope="col">Type</th>
                            <th scope="col">Default</th>
                            <th scope="col">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>limit</code></td>
                            <td>Integer</td>
                            <td>50</td>
                            <td>Number of cards to return. Must be between 1 and 100.</td>
                        </tr>
                        <tr>
                            <td><code>offset</code></td>
                            <td>Integer</td>
                            <td>0</td>
                            <td>Number of cards to skip. Must be zero or greater.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <p class="mb-2">Example request:</p>
            <pre class="bg-body-tertiary border rounded p-3"><code>GET https://www.carddweeb.com/api/cards?limit=25&amp;offset=0</code></pre>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h3 class="h5">
                <span class="badge text-bg-success me-2">GET</span>
                <code>/api/cards/sets</code>
            </h3>
            <p class="mb-0">Returns the available card sets.</p>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h3 class="h5">
                <span class="badge text-bg-success me-2">GET</span>
                <code>/api/cards/landscapes</code>
            </h3>
            <p class="mb-0">Returns the available landscape cards.</p>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h3 class="h5">
                <span class="badge text-bg-success me-2">GET</span>
                <code>/api/cards/cardtypes</code>
            </h3>
            <p class="mb-0">Returns the available card types.</p>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h3 class="h5">
                <span class="badge text-bg-success me-2">GET</span>
                <code>/api/decks</code>
            </h3>

            <p>
                Returns a paginated list of visible decks.
            </p>

            <div class="alert alert-info" role="alert">
                Only decks considered visible by CardDweeb are included.
                Private or otherwise non-visible decks are not intended to
                be exposed by this endpoint.
            </div>

            <h4 class="h6 mt-3">Query parameters</h4>

            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">Parameter</th>
                            <th scope="col">Type</th>
                            <th scope="col">Default</th>
                            <th scope="col">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>limit</code></td>
                            <td>Integer</td>
                            <td>50</td>
                            <td>
                                Maximum number of decks to return in one
                                response. Must be between 1 and 100.
                            </td>
                        </tr>
                        <tr>
                            <td><code>offset</code></td>
                            <td>Integer</td>
                            <td>0</td>
                            <td>
                                Number of decks to skip before returning
                                results. Must be zero or greater.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h4 class="h6 mt-3">Example requests</h4>

            <p class="mb-2">Retrieve the first page of decks:</p>
            <pre class="bg-body-tertiary border rounded p-3"><code>GET https://www.carddweeb.com/api/decks?limit=50&amp;offset=0</code></pre>

            <p class="mb-2">Retrieve the next page:</p>
            <pre class="bg-body-tertiary border rounded p-3"><code>GET https://www.carddweeb.com/api/decks?limit=50&amp;offset=50</code></pre>
        </div>
    </div>

    <h2 class="mt-4">Response Format</h2>
    <p>
        Successful requests return JSON using a consistent response structure.
        The following is an example of a paginated card response:
    </p>

    <pre class="bg-body-tertiary border rounded p-3"><code>{
  "data": [
    ...
  ],
  "elapsed": 12.4,
  "next": "https://www.carddweeb.com/api/[type]?limit=50&amp;offset=50",
  "total": 237,
  "count": 50,
  "limit": 50,
  "offset": 0
}</code></pre>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th scope="col">Property</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>data</code></td>
                    <td>The returned cards or other requested data.</td>
                </tr>
                <tr>
                    <td><code>elapsed</code></td>
                    <td>Time taken to retrieve the data, in milliseconds.</td>
                </tr>
                <tr>
                    <td><code>next</code></td>
                    <td>URL for the next page, or an empty value when no further page is available.</td>
                </tr>
                <tr>
                    <td><code>total</code></td>
                    <td>Total number of matching records available.</td>
                </tr>
                <tr>
                    <td><code>count</code></td>
                    <td>Number of records included in the current response.</td>
                </tr>
                <tr>
                    <td><code>limit</code></td>
                    <td>Maximum number of records requested for this response.</td>
                </tr>
                <tr>
                    <td><code>offset</code></td>
                    <td>Number of records skipped before this response.</td>
                </tr>
            </tbody>
        </table>
    </div>

    <h2 class="mt-4">Pagination</h2>
    <p>
        The cards endpoint supports pagination so clients can retrieve
        large datasets in smaller requests.
    </p>

    <ul>
        <li>
            <strong>First page:</strong>
            <code>/api/cards?limit=50&amp;offset=0</code>
        </li>
        <li>
            <strong>Second page:</strong>
            <code>/api/cards?limit=50&amp;offset=50</code>
        </li>
        <li>
            <strong>Third page:</strong>
            <code>/api/cards?limit=50&amp;offset=100</code>
        </li>
    </ul>

    <p>
        Whenever possible, follow the URL provided in the <code>next</code>
        property rather than manually constructing the next request.
        The <code>total</code> property represents the total number of
        records, while <code>count</code> represents the number returned
        in the current response.
    </p>

    <h2 class="mt-4">Errors</h2>
    <p>
        Invalid requests return an appropriate HTTP status code and a
        JSON error response.
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th scope="col">Status</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>400 Bad Request</code></td>
                    <td>Invalid pagination parameters or a missing User-Agent header.</td>
                </tr>
                <tr>
                    <td><code>404 Not Found</code></td>
                    <td>The requested endpoint or resource does not exist.</td>
                </tr>
                <tr>
                    <td><code>500 Internal Server Error</code></td>
                    <td>An unexpected server error occurred.</td>
                </tr>
            </tbody>
        </table>
    </div>

    <p>Example error response:</p>

    <pre class="bg-body-tertiary border rounded p-3"><code>{
  "title": "Invalid limit",
  "status": 400,
  "detail": "Limit must be between 1 and 100."
}</code></pre>

    <hr />

    <p class="text-body-secondary">
        The CardDweeb API is intended to make card data accessible to
        developers and community projects.
    </p>
</div>