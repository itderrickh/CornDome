@page
@inject AppFlagHelper AppFlags
@model IndexModel
@{
    ViewData["Title"] = "Home";
    var user = await Model.GetUser();
}

<div class="text-center">
    <h2 class="display-4">Welcome to the Card Wars Fan Site - Card Dweeb</h2>

    <section class="article-area">
        <div class="left-area">
            <img src="~/img/card-dweeb.jpg" alt="Jake holding a Dweeb and Cool Guy cups" class="w-100" />
            @if (AppFlags.IsActive("EnableAds") && (user == null || !User.IsInRole("CoolGuy") || !User.IsInRole("Admin")))
            {
                <div class="mt-4 container">
                    <p>Card Dweeb is maintained monetarily with advertisements. We do not profit directly from the site and all ad revenue goes directly into maintaining Card Dweeb for community members like you!</p>
                    <partial name="_BannerAd" />
                </div>
            }
        </div>
        <aside class="right-area">
            <div style="padding: 10px 5px; border-bottom: 1px solid lightgray">
                <h3>Card of the Day</h3>
                <a asp-page="/Card" asp-route-id="@Model.CardOfTheDay.Id">
                    <img class="w-100" style="max-width: 250px;" alt="@Model.CardOfTheDay.Name" src="@(Model.BaseUrl + Model.CardOfTheDay.GetOptimizedImage)" />
                </a>
            </div>
            <div style="padding: 10px 5px; border-bottom: 1px solid lightgray">
                <h3>Please support the 3rd Kickstarter if you can! It is fully funded with more stretch goals coming!</h3>
                <a href="https://www.kickstarter.com/projects/cze/adventure-time-card-wars-2026">Click Here!</a>
            </div>
            <div style="padding: 5px;">
                <h3>See upcoming features for Card Dweeb</h3>
                <a asp-page="/Resources/Backlog">Click Here!</a>
            </div>
        </aside>
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
}