@page
@model IndexModel
@{
    ViewData["Title"] = "Card Wars Helper Site";
}

<div class="text-center">
    <h2 class="display-4">Welcome to the Card Wars Fan Site - Card Dweeb</h2>

    <section class="article-area">
        <div class="left-area">
            <img src="~/img/card-dweeb.jpg" class="w-100" />
        </div>
        <aside class="right-area">
            <div style="padding: 10px 5px; border-bottom: 1px solid lightgray">
                <h3>Card of the Day</h3>
                <a asp-page="/Card" asp-route-id="@Model.CardOfTheDay.Id">
                    <img class="w-100" style="max-width: 250px;" alt="@Model.CardOfTheDay.LatestRevision.Name" src="@(Model.BaseUrl + Model.CardOfTheDay.LatestRevision.GetLargestImage)" />
                </a>
            </div>
            <div style="padding: 10px 5px; border-bottom: 1px solid lightgray">
                <h3>View the Card Wars 2025 project on Kickstarter</h3>
                <a href="https://www.kickstarter.com/projects/cze/adventure-time-card-wars-2025">Click Here!</a>
            </div>
            <div style="padding: 5px;">
                <h3>See upcoming features for CardDweeb</h3>
                <a asp-page="/Resources/Backlog">Click Here!</a>
            </div>
        </aside>
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="./css/index.css" asp-append-version="true" />
}