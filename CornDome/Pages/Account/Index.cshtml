@page
@model CornDome.Pages.Account.IndexModel
@{
    ViewData["Title"] = "Profile";
}

<div class="container">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <h1>User Settings</h1>
    <form method="post">
        <div class="form-group mb-2">
            <label asp-for="@Model.LocalUser.ColorMode" class="form-label mb-0">
                Theme
            </label>

            <select asp-for="@Model.LocalUser.ColorMode"
                    class="form-select form-select-sm"
                    style="width: auto;">
                <option value="0">System default</option>
                <option value="1">Light</option>
                <option value="2">Dark</option>
            </select>
        </div>
        <div class="form-group mb-2">
            <label for="Email">Email:</label>
            <span><b>@Model.LocalUser.Email</b> <br />(Note: This email is not displayed anywhere on the site and you will not be contacted directly by CardDweeb)</span>
        </div>
        <div class="form-group">
            <label asp-for="LocalUser.Username">Username (20 character max)</label>
            <input asp-for="LocalUser.Username" type="text" maxlength="20" class="form-control" />
        </div>
        <div class="form-group mt-2">
            <button type="submit" class="btn btn-primary">Update</button>
        </div>
    </form>
</div>
