@page
@model CornDome.Pages.Admin.BugManagementModel
@{
    ViewData["Title"] = "Bug Management";
}


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-primary fw-semibold small text-uppercase mb-2">
                CardDweeb / <a asp-page="/Admin/Index">Administration</a> / <a asp-page="/Admin/BugManagement">Bugs</a>
            </div>
            <h1 class="fw-bold mb-2">Bug Management</h1>
            <p class="text-muted mb-0">
                View and edit bugs.
            </p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped w-100 table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>User</th>
                        <th>Description</th>
                        <th>Steps</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Bugs.Count > 0)
                    {
                        @foreach (var bug in Model.Bugs.OrderBy(x => x.CreatedAt))
                        {
                            <tr>
                                <td>@bug.Title</td>
                                <td>@bug?.User?.UserName</td>
                                <td>@bug.Description</td>
                                <td>@bug.Steps</td>
                                <td>@bug.CreatedAt</td>
                                <td>
                                    <form method="post" asp-page-handler="RemoveBug" class="d-inline">
                                        <input type="text" name="RemoveBugId" value="@bug.Id" class="d-none" />
                                        <button type="submit" class="btn btn-danger">Squash Bug</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td>No Bugs Reported</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>