@page
@model CornDome.Pages.Admin.IndexModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-primary fw-semibold small text-uppercase mb-2">
                CardDweeb / <a asp-page="/Admin/Index">Administration</a>
            </div>
            <h1 class="fw-bold mb-2">Admin Dashboard</h1>
            <p class="text-muted mb-0">
                Manage your application, users, and infrastructure.
            </p>
        </div>
    </div>

    <div class="mb-3">
        <h2 class="h5 fw-bold mb-1">Application Management</h2>
        <p class="text-muted small mb-0">
            Tools for managing CardDweeb functionality.
        </p>
    </div>

    <div class="row g-4 mb-5">
        @foreach (var adminArea in Model.AdminAreas)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <a asp-page="@adminArea.Area" class="admin-card card h-100 text-decoration-none">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-start gap-3">
                            <div class="admin-icon bg-primary-subtle text-primary flex-shrink-0">
                                <i class="bi @adminArea.Icon" aria-hidden="true"></i>
                            </div>

                            <div class="flex-grow-1">
                                <h3 class="h5 fw-bold text-body">@adminArea.Name</h3>
                                <p class="text-muted mb-3">
                                    @adminArea.Description
                                </p>

                                <span class="admin-card-link text-primary fw-semibold">
                                    @adminArea.LinkText <span aria-hidden="true">→</span>
                                </span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .admin-card {
        border: 1px solid var(--bs-border-color);
        border-radius: 1rem;
        background: var(--bs-body-bg);
        transition: transform 160ms ease, box-shadow 160ms ease,
                    border-color 160ms ease;
    }

    .admin-card:hover {
        transform: translateY(-3px);
        border-color: var(--bs-primary-border-subtle);
        box-shadow: 0 .5rem 1.5rem rgba(0, 0, 0, .08);
    }

    .admin-card:focus-visible {
        outline: 3px solid var(--bs-primary);
        outline-offset: 3px;
    }

    .admin-icon {
        width: 3.25rem;
        height: 3.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 3.25rem;
        border-radius: .9rem;
        font-size: 1.4rem;
        margin-bottom: 1.5rem;
    }

    .admin-card-danger {
        border-color: var(--bs-danger-border-subtle);
    }

    .admin-card-danger:hover {
        border-color: var(--bs-danger);
    }

    @@media (prefers-reduced-motion: reduce) {
        .admin-card {
            transition: none;
        }

        .admin-card:hover {
            transform: none;
        }
    }
</style>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}