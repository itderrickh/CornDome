@page
@model CornDome.Pages.Admin.IndexModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-primary fw-semibold small text-uppercase mb-2">
                CardDweeb / <a asp-page="/Admin/Index">Administration</a>
            </div>
            <h1 class="fw-bold mb-2">Admin Dashboard</h1>
            <p class="text-muted mb-0">
                Manage your application, users, and infrastructure.
            </p>
        </div>
    </div>

    <div class="mb-3">
        <h2 class="h5 fw-bold mb-1">Application Management</h2>
        <p class="text-muted small mb-0">
            Tools for managing CardDweeb functionality and users.
        </p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-12 col-md-6 col-xl-4">
            <a asp-page="/Admin/UserManagement"
               class="admin-card card h-100 text-decoration-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="admin-icon bg-primary-subtle text-primary flex-shrink-0">
                            <i class="bi bi-people-fill" aria-hidden="true"></i>
                        </div>

                        <div class="flex-grow-1">
                            <h3 class="h5 fw-bold text-body">User Management</h3>
                            <p class="text-muted mb-3">
                                Manage user accounts, review user details, and
                                administer access to the application.
                            </p>

                            <span class="admin-card-link text-primary fw-semibold">
                                Manage users <span aria-hidden="true">→</span>
                            </span>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a asp-page="/Admin/AppFlags"
               class="admin-card card h-100 text-decoration-none">
               <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="admin-icon bg-primary-subtle text-primary flex-shrink-0">
                            <i class="bi bi-toggles" aria-hidden="true"></i>
                        </div>

                        <div class="flex-grow-1">
                            <h3 class="h5 fw-bold text-body">App Flags</h3>
                            <p class="text-muted mb-3">
                                Enable or disable features without deploying
                            application code.
                            </p>

                            <span class="admin-card-link text-primary fw-semibold">
                                Manage Flags <span aria-hidden="true">→</span>
                            </span>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a asp-page="/Admin/BugManagement"
               class="admin-card card h-100 text-decoration-none">
               <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="admin-icon bg-primary-subtle text-primary flex-shrink-0">
                            <i class="bi bi-bug-fill" aria-hidden="true"></i>
                        </div>

                        <div class="flex-grow-1">
                            <h3 class="h5 fw-bold text-body">Bug Management</h3>
                            <p class="text-muted mb-3">
                                Review reported issues, investigate problems,
                                and track bug reports.
                            </p>

                            <span class="admin-card-link text-primary fw-semibold">
                                Review Bugs <span aria-hidden="true">→</span>
                            </span>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <a asp-page="/Admin/ErrorLogs"
               class="admin-card card h-100 text-decoration-none">
               <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="admin-icon bg-primary-subtle text-primary flex-shrink-0">
                            <i class="bi bi-journal-x" aria-hidden="true"></i>
                        </div>

                        <div class="flex-grow-1">
                            <h3 class="h5 fw-bold text-body">Error Logs</h3>
                            <p class="text-muted mb-3">
                                View error logs from CardDweeb logging.
                            </p>

                            <span class="admin-card-link text-primary fw-semibold">
                                View Logs <span aria-hidden="true">→</span>
                            </span>
                        </div>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <div class="mb-3">
        <h2 class="h5 fw-bold mb-1">Infrastructure &amp; Data</h2>
        <p class="text-muted small mb-0">
            Manage database backups and recovery operations.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-12 col-md-6">
            <a asp-page="/Admin/DatabaseBackup"
               class="admin-card card h-100 text-decoration-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="admin-icon bg-info-subtle text-info-emphasis flex-shrink-0">
                            <i class="bi bi-database-fill-check" aria-hidden="true"></i>
                            <span class="visually-hidden">Database backup</span>
                        </div>

                        <div class="flex-grow-1">
                            <h3 class="h5 fw-bold text-body">Database Backup</h3>
                            <p class="text-muted mb-3">
                                Create and manage database backups to protect
                                application data.
                            </p>

                            <span class="admin-card-link text-primary fw-semibold">
                                Backup Now <span aria-hidden="true">→</span>
                            </span>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-6">
            <a asp-page="/Admin/DatabaseRestore"
               class="admin-card admin-card-danger card h-100 text-decoration-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="admin-icon bg-danger-subtle text-danger flex-shrink-0">
                            <i class="bi bi-database-fill-gear" aria-hidden="true"></i>
                            <span class="visually-hidden">Database restore</span>
                        </div>

                        <div class="flex-grow-1">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <h3 class="h5 fw-bold text-body mb-0">
                                    Database Restore
                                </h3>
                                <span class="badge text-bg-danger">Caution</span>
                            </div>

                            <p class="text-muted mb-3">
                                Restore application data from a backup.
                            </p>

                            <span class="admin-card-link text-danger fw-semibold">
                                Open restore tools <span aria-hidden="true">→</span>
                            </span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    .admin-card {
        border: 1px solid var(--bs-border-color);
        border-radius: 1rem;
        background: var(--bs-body-bg);
        transition: transform 160ms ease, box-shadow 160ms ease,
                    border-color 160ms ease;
    }

    .admin-card:hover {
        transform: translateY(-3px);
        border-color: var(--bs-primary-border-subtle);
        box-shadow: 0 .5rem 1.5rem rgba(0, 0, 0, .08);
    }

    .admin-card:focus-visible {
        outline: 3px solid var(--bs-primary);
        outline-offset: 3px;
    }

    .admin-icon {
        width: 3.25rem;
        height: 3.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 3.25rem;
        border-radius: .9rem;
        font-size: 1.4rem;
        margin-bottom: 1.5rem;
    }

    .admin-card-danger {
        border-color: var(--bs-danger-border-subtle);
    }

    .admin-card-danger:hover {
        border-color: var(--bs-danger);
    }

    @@media (prefers-reduced-motion: reduce) {
        .admin-card {
            transition: none;
        }

        .admin-card:hover {
            transform: none;
        }
    }
</style>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}