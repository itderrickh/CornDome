@page
@model CornDome.Pages.Admin.ErrorLogsModel
@{
    ViewData["RenderMode"] = "wide";
    ViewData["Title"] = "Error Logs";

    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}

<h1>Request Logs</h1>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Date</th>
            <th>Method</th>
            <th>Path</th>
            <th>Status</th>
            <th>Duration</th>
            <th>User</th>
            <th>IP</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var log in Model.Logs)
        {
            <tr>
                <td title="@log.Timestamp.ToLocalTime()">
                    @log.Timestamp.ToLocalTime().ToShortDateString()
                </td>
                <td>
                    @log.Method
                </td>
                <td>
                    @(log.Path + log.QueryString)
                </td>
                <td>
                    @if (log.StatusCode >= 500)
                    {
                        <span class="badge bg-danger">
                            @log.StatusCode
                        </span>
                    }
                    else if (log.StatusCode >= 400)
                    {
                        <span class="badge bg-warning">
                            @log.StatusCode
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            @log.StatusCode
                        </span>
                    }
                </td>
                <td>
                    @log.DurationMs ms
                </td>
                <td>
                    @log.UserName
                </td>
                <td>
                    @log.RemoteIp
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(log.Exception))
                    {
                        <button class="btn btn-sm btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#exceptionModal"
                                data-exception="@log.Exception">
                            Error
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (totalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-3">

        <div>
            <span class="text-muted">
                Page @Model.PageNumber of @totalPages
                (@Model.TotalCount total logs)
            </span>
        </div>

        <nav aria-label="Error log pagination">
            <ul class="pagination mb-0">

                @* Previous *@
                @if (Model.PageNumber > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize" asp-page="/Admin/ErrorLogs">
                            Previous
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">Previous</span>
                    </li>
                }

                @{
                    var startPage = Math.Max(1, Model.PageNumber - 2);
                    var endPage = Math.Min(totalPages, Model.PageNumber + 2);
                }

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-route-pageNumber="1"
                           asp-route-pageSize="@Model.PageSize"
                           asp-page="/Admin/ErrorLogs">
                            1
                        </a>
                    </li>

                    @if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                @for (var i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@Model.PageSize"
                           asp-page="/Admin/ErrorLogs">
                            @i
                        </a>
                    </li>
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }

                    <li class="page-item">
                        <a class="page-link"
                           asp-route-pageNumber="@totalPages"
                           asp-route-pageSize="@Model.PageSize"
                           asp-page="/Admin/ErrorLogs">
                            @totalPages
                        </a>
                    </li>
                }

                @* Next *@
                @if (Model.PageNumber < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-page="/Admin/ErrorLogs">
                            Next
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">Next</span>
                    </li>
                }

            </ul>
        </nav>

        @* Page size *@
        <div>
            <select class="form-select form-select-sm"
                    style="width: auto;"
                    onchange="changePageSize(this.value)">
                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
                <option value="100" selected="@(Model.PageSize == 100)">100</option>
                <option value="250" selected="@(Model.PageSize == 250)">250</option>
                <option value="500" selected="@(Model.PageSize == 500)">500</option>
            </select>
        </div>

    </div>
}

<div class="modal fade" id="exceptionModal" tabindex="-1"
     aria-labelledby="exceptionModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"
                    id="exceptionModalLabel"
                    style="color: black;">
                    Exception Details
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <pre id="exceptionText"
                     class="mb-0"
                     style="white-space: pre-wrap; color: black;"></pre>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const exceptionModal = document.getElementById('exceptionModal');

        exceptionModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const exception = button.getAttribute('data-exception');

            document.getElementById('exceptionText').textContent = exception;
        });

        function changePageSize(size) {
            const url = new URL(window.location.href);

            url.searchParams.set('pageNumber', '1');
            url.searchParams.set('pageSize', size);

            window.location.href = url.toString();
        }
    </script>
}

@section Styles {
    <style>
        table {
            width: 100%;
            table-layout: fixed;
            border-collapse: collapse;
        }

        td, th {
            overflow-wrap: break-word;
        }
    </style>
}
