@page
@model CornDome.Pages.Admin.ErrorLogsModel
@{
    ViewData["RenderMode"] = "wide";
    ViewData["Title"] = "Error Logs";
}

<h1>Request Logs</h1>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Date</th>
            <th>Method</th>
            <th>Path</th>
            <th>Status</th>
            <th>Duration</th>
            <th>User</th>
            <th>IP</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var log in Model.Logs)
        {
            <tr>
                <td title="@log.Timestamp.ToLocalTime()">
                    @log.Timestamp.ToShortDateString()
                </td>
                <td>
                    @log.Method
                </td>
                <td>
                    @(log.Path + log.QueryString)
                </td>
                <td>
                    @if (log.StatusCode >= 500)
                    {
                        <span class="badge bg-danger">
                            @log.StatusCode
                        </span>
                    }
                    else if (log.StatusCode >= 400)
                    {
                        <span class="badge bg-warning">
                            @log.StatusCode
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            @log.StatusCode
                        </span>
                    }
                </td>
                <td>
                    @log.DurationMs ms
                </td>
                <td>
                    @log.UserName
                </td>
                <td>
                    @log.RemoteIp
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(log.Exception))
                    {
                        <button class="btn btn-sm btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#exceptionModal"
                                data-exception="@log.Exception">
                            Error
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="exceptionModal" tabindex="-1" aria-labelledby="exceptionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exceptionModalLabel" style="color: black;">Exception Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <pre id="exceptionText" class="mb-0" style="white-space: pre-wrap; color: black;"></pre>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const exceptionModal = document.getElementById('exceptionModal');

        exceptionModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const exception = button.getAttribute('data-exception');

            document.getElementById('exceptionText').textContent = exception;
        });
    </script>
}

@section Styles {
    <style>
        table {
            width: 100%;
            table-layout: fixed;
            border-collapse: collapse;
        }

        td, th {
            overflow-wrap: break-word;
        }
    </style>
}