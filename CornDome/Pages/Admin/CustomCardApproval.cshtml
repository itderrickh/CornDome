@page
@model CornDome.Pages.Admin.CustomCardApprovalModel
@{
    ViewData["Title"] = "Custom Card Approval";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-primary fw-semibold small text-uppercase mb-2">
                CardDweeb / <a asp-page="/Admin/Index">Administration</a> / <a asp-page="/Admin/CustomCardApproval">Custom Card Approval</a>
            </div>
            <h1 class="fw-bold mb-2">Custom Card Approval</h1>
            <p class="text-muted mb-0">
                Deny or Approve custom cards for display on Card Dweeb.
            </p>
        </div>
        <span class="badge bg-warning text-dark fs-6" id="pending-count">
            @Model.Cards.Count Pending
        </span>
    </div>

    @Html.AntiForgeryToken()

    @if (!Model.Cards.Any())
    {
        <div class="alert alert-success" id="empty-message">
            <i class="bi bi-check-circle"></i>
            There are no custom cards waiting for approval.
        </div>
    }

    <div class="row g-4" id="approval-list">
        @foreach (var card in Model.Cards)
        {
            <div class="col-12" id="card-@card.Id">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="row g-4">
                            <div class="col-md-4 col-lg-3 text-center">
                                <img src="@card.ImageUrl"
                                     alt="@card.Name"
                                     class="img-fluid rounded"
                                     style="max-height: 420px; object-fit: contain;" />

                                <div class="mt-3">
                                    <span class="badge bg-warning text-dark">
                                        Pending Approval
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-8 col-lg-9">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div>
                                        <h4 class="mb-1">@card.Name</h4>
                                        <div class="text-muted">
                                            @card.CardType · @card.Landscape
                                        </div>
                                    </div>

                                    <span class="badge bg-secondary">
                                        Requested: @card.Visibility
                                    </span>
                                </div>

                                <hr />

                                <div class="row g-3">
                                    <div class="col-sm-6 col-lg-4">
                                        <div class="text-muted small">Cost</div>
                                        <strong>@(card.Cost?.ToString() ?? "N/A")</strong>
                                    </div>

                                    <div class="col-sm-6 col-lg-4">
                                        <div class="text-muted small">Attack</div>
                                        <strong>@(card.Attack?.ToString() ?? "N/A")</strong>
                                    </div>

                                    <div class="col-sm-6 col-lg-4">
                                        <div class="text-muted small">Defense</div>
                                        <strong>@(card.Defense?.ToString() ?? "N/A")</strong>
                                    </div>

                                    <div class="col-12">
                                        <div class="text-muted small">Ability</div>
                                        <div class="border rounded p-3 mt-1" style="white-space: pre-wrap;">@card.Ability</div>
                                    </div>

                                    <div class="col-sm-6">
                                        <div class="text-muted small">Author</div>
                                        <strong>@(card.Author ?? "Not provided")</strong>
                                    </div>

                                    <div class="col-sm-6">
                                        <div class="text-muted small">Artist</div>
                                        <strong>@(card.Artist ?? "Not provided")</strong>
                                    </div>

                                    <div class="col-sm-6">
                                        <div class="text-muted small">Submitted</div>
                                        <strong>@card.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</strong>
                                    </div>

                                    <div class="col-sm-6">
                                        <div class="text-muted small">User ID</div>
                                        <strong>@card.UserId</strong>
                                    </div>
                                </div>

                                <hr />

                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button"
                                            class="btn btn-outline-danger deny-card"
                                            data-id="@card.Id"
                                            data-name="@card.Name">
                                        <i class="bi bi-x-circle"></i>
                                        Deny
                                    </button>

                                    <button type="button"
                                            class="btn btn-success approve-card"
                                            data-id="@card.Id"
                                            data-name="@card.Name">
                                        <i class="bi bi-check-circle"></i>
                                        Approve Card
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/cardapproval.js"></script>
}