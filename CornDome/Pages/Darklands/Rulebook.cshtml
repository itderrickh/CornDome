    <div class="rulebook-page"><img alt="Rulebook page image 4" src="~/img/darklands_rulebook/3.png" /></div>
    <div class="rulebook-page"><img alt="Rulebook page image 5" src="~/img/darklands_rulebook/4.png" /></div>
    <div class="rulebook-page"><img alt="Rulebook page image 6" src="~/img/darklands_rulebook/5.png" /></div>
    <div class="rulebook-page"><img alt="Rulebook page image 7" src="~/img/darklands_rulebook/6.png" /></div>
    <div class="rulebook-page"><img alt="Rulebook page image 8" src="~/img/darklands_rulebook/7.png" /></div>
    <div class="rulebook-page"><img alt="Rulebook page image 9" src="~/img/darklands_rulebook/8.png" /></div>
