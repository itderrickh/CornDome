@page
@model CornDome.Pages.Darklands.ManageModel

@{
    ViewData["Title"] = "DarkLands Card Manager";
}

<div class="container py-4 darklands-manager">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-primary fw-semibold small text-uppercase mb-2">
                CardDweeb / <a asp-page="/Admin/Index">Administration</a> / <a asp-page="/Darklands/Manage">DarkLand Card Management</a>
            </div>

            <h1 class="fw-bold mb-2">
                <i class="bi bi-moon-stars me-2 text-primary"></i>
                DarkLands Card Manager
            </h1>

            <p class="text-muted mb-0">
                Manage DarkLands cards, card types, and overlords.
            </p>
        </div>

        <a asp-page="/Darklands/Add" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>
            Add Card
        </a>
    </div>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Summary -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="darklands-stat-icon bg-primary-subtle text-primary">
                        <i class="bi bi-collection"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">TOTAL CARDS</div>
                        <div class="fs-3 fw-bold">@Model.DarklandsCards.Count()</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="darklands-stat-icon bg-success-subtle text-success">
                        <i class="bi bi-tags"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">CARD TYPES</div>
                        <div class="fs-3 fw-bold">
                            @Model.DarklandsCards.Select(c => c.CardTypeId).Distinct().Count()
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="darklands-stat-icon bg-warning-subtle text-warning">
                        <i class="bi bi-shield-shaded"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">OVERLORDS</div>
                        <div class="fs-3 fw-bold">
                            @Model.DarklandsCards.Where(c => c.OverlordId != null).Select(c => c.OverlordId).Distinct().Count()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card List -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-body border-0 pt-4 px-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="fw-bold mb-1">DarkLands Cards</h5>
                    <p class="text-muted small mb-0">
                        Browse, search, and manage your card collection.
                    </p>
                </div>

                <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2" id="visibleCount">
                    @Model.DarklandsCards.Count() cards
                </span>
            </div>

            <div class="row g-2 mt-3 mb-2">
                <div class="col-12 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-body">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="search"
                               class="form-control"
                               id="nameFilter"
                               placeholder="Search cards by name..."
                               autocomplete="off" />
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <select class="form-select" id="typeFilter">
                        <option value="">All card types</option>
                        @foreach (var type in Model.DarklandsCards
                            .Where(c => c.CardType != null)
                            .Select(c => c.CardType!.Description)
                            .Distinct()
                            .OrderBy(x => x))
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <select class="form-select" id="overlordFilter">
                        <option value="">All overlords</option>
                        @foreach (var overlord in Model.DarklandsCards
                            .Where(c => c.Overlord != null)
                            .Select(c => c.Overlord!.Description)
                            .Distinct()
                            .OrderBy(x => x))
                        {
                            <option value="@overlord">@overlord</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 darklands-table">
                    <thead>
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Card Name</th>
                            <th>Card Type</th>
                            <th>Overlord</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="darklandsCardList">
                        @foreach (var card in Model.DarklandsCards.OrderBy(c => c.Name))
                        {
                            <tr class="darklands-card-row"
                                data-name="@card.Name"
                                data-type="@card.CardType?.Description"
                                data-overlord="@card.Overlord?.Description">

                                <td class="ps-4 text-muted small">
                                    @card.Id
                                </td>

                                <td>
                                    <a asp-page="/Darklands/Card"
                                       asp-route-id="@card.Id"
                                       class="fw-semibold text-decoration-none darklands-card-name">
                                        @card.Name
                                    </a>
                                </td>

                                <td>
                                    @if (card.CardType != null)
                                    {
                                        <span class="badge bg-primary-subtle text-primary">
                                            @card.CardType.Description
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Unassigned</span>
                                    }
                                </td>

                                <td>
                                    @if (card.Overlord != null)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis">
                                            <i class="bi bi-shield me-1"></i>
                                            @card.Overlord.Description
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-page="/Darklands/Edit"
                                           asp-route-id="@card.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit card">
                                            <i class="bi bi-pencil"></i>
                                            <span class="d-none d-lg-inline ms-1">Edit</span>
                                        </a>

                                        @if (UserRoleHelper.IsAdmin(User))
                                        {
                                            <form asp-page-handler="DeleteDarklandsCard"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to permanently delete @card.Name?');">
                                                <input type="hidden" name="DeleteDarklandsCardId" value="@card.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete card">
                                                    <i class="bi bi-trash"></i>
                                                    <span class="d-none d-lg-inline ms-1">Delete</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="emptyResults" class="text-center py-5 d-none">
                <i class="bi bi-search fs-1 text-muted"></i>
                <h6 class="fw-bold mt-3">No cards found</h6>
                <p class="text-muted small mb-3">
                    Try adjusting your search or filters.
                </p>
                <button type="button" class="btn btn-sm btn-outline-primary" id="clearFilters">
                    Clear Filters
                </button>
            </div>
        </div>

        <div class="card-footer bg-body border-0 px-4 py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i>
                    Select a card name to view its details.
                </span>
                <span class="text-muted small">
                    @if (UserRoleHelper.IsAdmin(User))
                    {
                        <i class="bi bi-shield-check me-1"></i>
                        <span>Administrator access enabled</span>
                    }
                </span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/darklands//manage.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/cardManage/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/darklands/manage.css" asp-append-version="true" />
}
