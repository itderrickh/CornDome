@page
@using System.Text.Json
@model CornDome.Pages.GoldfishModel
@{
    ViewData["RenderMode"] = "wide";
    ViewData["Title"] = "Goldfish";
}

@if (Model.QueryDeck == null)
{
    ViewData["RenderMode"] = "normal";
    <h1>No deck selected. Build a deck and try to goldfish again.</h1>
}
else
{
    @if (Model.QueryDeck.Landscapes.Count < 4)
    {
        <div class="container text-center m-5">
            <span> Deck does not have required amount of landscapes</span>
        </div>
    }
    else if (Model.QueryDeck.Cards.Count < 40)
    {
        <div class="container text-center m-5">
            <span>Deck does not have enough cards</span>
        </div>
    }
    else
    {
        <div class="game-board">
            <div id="deck" class="deck">
                <span>Deck (<span id="deck-size"></span>)</span>
                <div class="cardslot">
                    <div class="card-placeholder">
                        <img src="/img/lifebackground.jpg" />
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap position-relative w-55" style="width: 55%;">
                <div class="d-flex w-100" style="height: 65%">
                    <cd-landscape id="landscape1" class="landscape drop-landscape" data-landscape="landscape1" alt-text="@Model.QueryDeck.Landscapes[0].LatestRevision.Name" landscape-image="@(Model.BaseUrl + @Model.QueryDeck.Landscapes[0].LatestRevision.GetRegularImage)"></cd-landscape>
                    <cd-landscape id="landscape2" class="landscape drop-landscape" data-landscape="landscape2" alt-text="@Model.QueryDeck.Landscapes[1].LatestRevision.Name" landscape-image="@(Model.BaseUrl + @Model.QueryDeck.Landscapes[1].LatestRevision.GetRegularImage)"></cd-landscape>
                    <cd-landscape id="landscape3" class="landscape drop-landscape" data-landscape="landscape3" alt-text="@Model.QueryDeck.Landscapes[2].LatestRevision.Name" landscape-image="@(Model.BaseUrl + @Model.QueryDeck.Landscapes[2].LatestRevision.GetRegularImage)"></cd-landscape>
                    <cd-landscape id="landscape4" class="landscape drop-landscape" data-landscape="landscape4" alt-text="@Model.QueryDeck.Landscapes[3].LatestRevision.Name" landscape-image="@(Model.BaseUrl + @Model.QueryDeck.Landscapes[3].LatestRevision.GetRegularImage)"></cd-landscape>
                </div>

                <div class="d-flex w-100" style="height: 35%">
                    <cd-building id="building1" data-building="building1" class="w-25"></cd-building>
                    <cd-building id="building2" data-building="building2" class="w-25"></cd-building>
                    <cd-building id="building3" data-building="building3" class="w-25"></cd-building>
                    <cd-building id="building4" data-building="building4" class="w-25"></cd-building>
                </div>
            </div>

            <div id="spellzone" ondragover="event.preventDefault()">
                <span>Spell Zone</span>
                <div class="cardslot"></div>
            </div>

            <div id="discard">
                <span>Discard</span>
                <div class="cardslot"></div>
            </div>
        </div>

        <div id="control-board">
            <div id="lifetotal">
            </div>
            <div id="hand" style="">
            </div>
        </div>

        <context-menu target-class="card" id="cardMenu"></context-menu>
        <context-menu target-id="deck" id="deckMenu"></context-menu>
        <context-menu target-id="spellzone" id="spellzoneMenu"></context-menu>
        <context-menu target-id="discard" id="discardMenu"></context-menu>

        <!-- Modal for Deck and Discard -->
        <div id="deckModal" class="cd-modal">
            <context-menu target-class="deckCard" id="deckSubMenu"></context-menu>
            <div class="modal-content">
                <button class="close-btn" onclick="closeModal('deckModal')">Close</button>
                <ul id="deckList"></ul>
            </div>
        </div>

        <div id="discardModal" class="cd-modal">
            <context-menu target-class="discardCard" id="discardSubMenu"></context-menu>
            <div class="modal-content">
                <button class="close-btn" onclick="closeModal('discardModal')">Close</button>
                <ul id="discardList"></ul>
            </div>
        </div>

        @section Styles {
            <link rel="stylesheet" href="~/css/goldfish.css" asp-append-version="true" />
        }

        @section Scripts {
            <script>
                var baseUrl = '@(Model.BaseUrl)';
            </script>
            <script id="deck-data" type="application/json">
                @Html.Raw(JsonSerializer.Serialize(Model.QueryDeck.Cards))
            </script>
            <script src="~/js/goldfish/contextMenu.js" asp-append-version="true"></script>
            <script src="~/js/goldfish/landscape.js" asp-append-version="true"></script>
            <script src="~/js/goldfish/building.js" asp-append-version="true"></script>

            <script src="~/js/goldfish/goldfish.js" asp-append-version="true"></script>
        }
    }
}