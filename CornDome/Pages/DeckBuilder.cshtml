@page
@model DeckBuilderModel
@{
    ViewData["RenderMode"] = "wide";
    ViewData["Title"] = "Deck Builder";
}

@if (Model.QueryBuildFailed)
{
    <div class="mb-1">
        <h2>Deck could not be built from the URL provided. Please submit a <a asp-page="/ReportABug">bug report</a> with details about how you received this link so we can investigate.</h2>
    </div>
}

<div class="builder-area">
    @Html.AntiForgeryToken()
    <div class="tool-area">
        <fieldset class="stats">
            <legend>Stats</legend>
            <div><span class="info-stamp" title="The minimum deck limit is 40 cards."></span> Total Cards: <span id="total-stat">0</span></div>
            <br />
            <div><span class="info-stamp" title="Only 1 Hero is allowed per deck."></span> Heroes: <span id="heroes-stat">0</span></div>
            <div><span class="info-stamp" title="Only 4 Landscapes are allowed per deck."></span> Landscapes: <span id="landscapes-stat">0</span></div>
            <div><span class="info-stamp" title="You can have as many creatures as you like."></span> Creatures: <span id="creature-stat">0</span></div>
            <div><span class="info-stamp" title="You can have as many spells as you like."></span> Spells: <span id="spell-stat">0</span></div>
            <div><span class="info-stamp" title="You can have as many buildings as you like."></span> Buildings: <span id="building-stat">0</span></div>
            <div><span class="info-stamp" title="You can have as many teamworks as you like."></span> Teamworks: <span id="teamwork-stat">0</span></div>
            <br />
            <div>Blue Plains: <span id="bp-stat">0</span></div>
            <div>Cornfield: <span id="cf-stat">0</span></div>
            <div>Useless Swamp: <span id="us-stat">0</span></div>
            <div>SandyLands: <span id="sl-stat">0</span></div>
            <div>NiceLands: <span id="nl-stat">0</span></div>
            <div>IcyLands: <span id="il-stat">0</span></div>
            <div>Rainbow: <span id="rb-stat">0</span></div>
            <div>LavaFlats: <span id="lf-stat">0</span></div>
        </fieldset>

        <fieldset id="actions">
            <legend>Actions</legend>
            <button id="validateButton" type="button" class="btn btn-lg btn-block btn-primary">Validate Deck</button>
            <button id="decklistExport" type="button" class="btn btn-lg btn-block btn-primary">Copy decklist to clipboard</button>
            <button id="permalinkExport" type="button" class="btn btn-lg btn-block btn-primary">Copy permalink to clipboard</button>
            <a class="btn btn-lg btn-block btn-primary" asp-page="Goldfish" asp-route-deck="@(Model.NonGZDeck)" asp-route-gzdeck="@(Model.GzDeck)">Try it out</a>
            @if (User.Identity.IsAuthenticated)
            {
                <button id="saveDatabaseButton2" type="button" class="btn btn-lg btn-block btn-primary" data-bs-toggle="modal" data-bs-target="#saveModal">
                    Save Deck
                </button>
            }
            else
            {
                <button id="disabledSave" type="button" class="btn btn-lg btn-block btn-secondary btn-disabled" disabled>
                    Login to Save Decks
                </button>
            }
            
            <button id="textExportUntap" type="button" class="btn btn-lg btn-block btn-primary">Untap.in Export</button>
            <button id="textExport" type="button" class="btn btn-lg btn-block btn-primary">Text Export</button>
            <textarea id="textExportField" style="width: 100%; display: none;" rows="20"></textarea>
            <!--<button id="" type="button" class="btn btn-lg btn-block btn-primary">Data Dive</button>-->
        </fieldset>
    </div>
    <div class="deck-area">
        <h2>Hero</h2>
        <div id="deck-hero">
            @if (Model.QueryDeck != null)
            {
                @if (Model.QueryDeck.Hero != null)
                {
                    CardViewModel cvm = new CardViewModel() { Card = Model.QueryDeck.Hero, IsDeleteable = true, BaseUrl = Model.BaseUrl };
                    <partial name="_Card" model="cvm" />
                }
            }
        </div>

        <h2>Landscapes</h2>
        <div id="deck-landscapes">
            @if (Model.QueryDeck != null)
            {
                @foreach (var landscape in Model.QueryDeck.Landscapes.Where(x => x != null))
                {
                    CardViewModel cvm = new CardViewModel() { Card = landscape, IsDeleteable = true, BaseUrl = Model.BaseUrl };
                    <partial name="_Card" model="cvm" />
                }
            }
        </div>

        <h2>Creatures, Spells, and Buildings</h2>
        <div id="deck-cards">
            @if (Model.QueryDeck != null)
            {
                @foreach (var card in Model.QueryDeck.Cards.Where(x => x != null))
                {
                    CardViewModel cvm = new CardViewModel() { Card = card, IsDeleteable = true, BaseUrl = Model.BaseUrl };
                    <partial name="_Card" model="cvm" />
                }
            }
        </div>
    </div>
    <div class="library-area">
        <fieldset id="filterBox">
            <legend>Filters</legend>
            <div class="filter-group">
                <label for="cardTypeFilter" class="filter-label">Card Type: </label>
                <select id="cardTypeFilter">
                    <option value="">- None -</option>
                    <option value="@((int)CardTypeEnum.Creature)">Creature</option>
                    <option value="@((int)CardTypeEnum.Spell)">Spell</option>
                    <option value="@((int)CardTypeEnum.Building)">Building</option>
                    <option value="@((int)CardTypeEnum.Hero)">Hero</option>
                    <option value="@((int)CardTypeEnum.Landscape)">Landscape</option>
                    <option value="@((int)CardTypeEnum.Teamwork)">Teamwork</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="setFilter" class="filter-label">Set: </label>
                <select id="setFilter">
                    <option value="">- None -</option>
                    <option value="@((int)Set.FinnVSJake)">@SetConverter.ToString(Set.FinnVSJake)</option>
                    <option value="@((int)Set.BMOVSLadyRainicorn)">@SetConverter.ToString(Set.BMOVSLadyRainicorn)</option>
                    <option value="@((int)Set.PrincessBubblegumVSLumpySpacePrincess)">@SetConverter.ToString(Set.PrincessBubblegumVSLumpySpacePrincess)</option>
                    <option value="@((int)Set.IceKingVSMarceline)">@SetConverter.ToString(Set.IceKingVSMarceline)</option>
                    <option value="@((int)Set.LemonGrabVSGunter)">@SetConverter.ToString(Set.LemonGrabVSGunter)</option>
                    <option value="@((int)Set.FionnaVSCake)">@SetConverter.ToString(Set.FionnaVSCake)</option>
                    <option value="@((int)Set.DoublesTournament)">@SetConverter.ToString(Set.DoublesTournament)</option>
                    <option value="@((int)Set.HeroPack)">@SetConverter.ToString(Set.HeroPack)</option>
                    <option value="@((int)Set.ForTheGlory)">@SetConverter.ToString(Set.ForTheGlory)</option>
                    <option value="@((int)Set.Promo)">@SetConverter.ToString(Set.Promo)</option>
                    <option value="@((int)Set.Kickstarter1)">@SetConverter.ToString(Set.Kickstarter1)</option>
                    <option value="@((int)Set.FlamePrincessVSFern)">@SetConverter.ToString(Set.FlamePrincessVSFern)</option>
                    <option value="@((int)Set.PrismoVSTheLich)">@SetConverter.ToString(Set.PrismoVSTheLich)</option>
                    <option value="@((int)Set.PeppermintButlerVSMagicMan)">@SetConverter.ToString(Set.PeppermintButlerVSMagicMan)</option>
                    <option value="@((int)Set.Kickstarter2)">@SetConverter.ToString(Set.Kickstarter2)</option>
                    <option value="@((int)Set.DarklandsExpansion)">@SetConverter.ToString(Set.DarklandsExpansion)</option>
                    <option value="@((int)Set.CustomCards)">@SetConverter.ToString(Set.CustomCards)</option>
                    <option value="@((int)Set.LandOfLegends)">@SetConverter.ToString(Set.LandOfLegends)</option>
                    <option value="@((int)Set.Kickstarter3)">@SetConverter.ToString(Set.Kickstarter3)</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="nameFilter" class="filter-label">Name: </label>
                <input type="text" id="nameFilter" />
            </div>
            <div class="filter-group">
                <label for="abilityFilter" class="filter-label">Ability: </label>
                <input type="text" id="abilityFilter" />
            </div>
            <div class="filter-group">
                <label for="costFilter" class="filter-label">Cost: </label>
                <input type="number" id="costFilter" />
            </div>
            <div class="filter-group">
                <label for="attackFilter" class="filter-label">Attack: </label>
                <input type="number" id="attackFilter" />
            </div>
            <div class="filter-group">
                <label for="defenseFilter" class="filter-label">Defense: </label>
                <input type="number" id="defenseFilter" />
            </div>
            <div class="mb-2 text-center">
                <label for="customCardFilter" class="filter-label" style="width: inherit;">Show Community Made Cards: </label>
                <input type="checkbox" class="form-check-input" id="customCardFilter" />
            </div>
            <div class="filter-group" id="checkbox-filter-group">
                <label for="cardTypeFilter" class="filter-label">Landscape: </label>
                <div id="checkboxes">
                    <label><input type="checkbox" class="landscape-checkbox form-check-input" value="@((int)LandscapeEnum.BluePlains)" /> @LandscapeConverter.ToString(LandscapeEnum.BluePlains)</label>
                    <label><input type="checkbox" class="landscape-checkbox form-check-input" value="@((int)LandscapeEnum.CornField)" /> @LandscapeConverter.ToString(LandscapeEnum.CornField)</label>
                    <label><input type="checkbox" class="landscape-checkbox form-check-input" value="@((int)LandscapeEnum.UselessSwamp)" /> @LandscapeConverter.ToString(LandscapeEnum.UselessSwamp)</label>
                    <label><input type="checkbox" class="landscape-checkbox form-check-input" value="@((int)LandscapeEnum.SandyLands)" /> @LandscapeConverter.ToString(LandscapeEnum.SandyLands)</label>
                    <label><input type="checkbox" class="landscape-checkbox form-check-input" value="@((int)LandscapeEnum.NiceLands)" /> @LandscapeConverter.ToString(LandscapeEnum.NiceLands)</label>
                    <label><input type="checkbox" class="landscape-checkbox form-check-input" value="@((int)LandscapeEnum.IcyLands)" /> @LandscapeConverter.ToString(LandscapeEnum.IcyLands)</label>
                    <label><input type="checkbox" class="landscape-checkbox form-check-input" value="@((int)LandscapeEnum.Rainbow)" /> @LandscapeConverter.ToString(LandscapeEnum.Rainbow)</label>
                    <label><input type="checkbox" class="landscape-checkbox form-check-input" value="@((int)LandscapeEnum.LavaFlats)" /> @LandscapeConverter.ToString(LandscapeEnum.LavaFlats)</label>
                </div>
            </div>
            <div class="filter-group mb-2 text-center">
                <input type="checkbox" id="burnTokenFilter" class="custom-checkbox custom-checkbox-burn" />
                <label for="burnTokenFilter" class="checkbox-label checkbox-label-burn"></label>

                <input type="checkbox" id="freezeTokenFilter" class="custom-checkbox custom-checkbox-freeze" />
                <label for="freezeTokenFilter" class="checkbox-label checkbox-label-freeze"></label>

                <input type="checkbox" id="attackTokenFilter" class="custom-checkbox custom-checkbox-attack" />
                <label for="attackTokenFilter" class="checkbox-label checkbox-label-attack"></label>
            </div>
            <div class="filter-group">
                <label for="sortOption" class="filter-label">Sort By: </label>
                <select id="sortOption" autocomplete="off">
                    <option value="name">Name</option>
                    <option value="cost">Cost</option>
                    <option value="set">Set</option>
                    <option value="cardType">Card Type</option>
                    <option value="attack">Attack</option>
                    <option value="defense">Defense</option>
                    <option value="landscape">Landscape</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="sortAscDesc" class="filter-label">Sort Direction: </label>
                <select id="sortAscDesc" autocomplete="off">
                    <option value="a">Ascending</option>
                    <option value="b">Descending</option>
                </select>
            </div>
        </fieldset>
        <div class="d-flex flex-wrap" id="card-list">
            @foreach (var card in Model.Cards.OrderBy(x => x.LatestRevision.Name))
            {
                CardViewModel cvm = new CardViewModel() { Card = card, IsAddable = true, BaseUrl = Model.BaseUrl };
                <div class="card-element">
                    <partial name="_Card" model="cvm" />
                </div>
            }
        </div>
    </div>
</div>

<!-- Create / Edit Deck Modal -->
<div class="modal fade" id="saveModal" tabindex="-1" aria-labelledby="saveModalLabel" aria-hidden="true" style="color: black;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="saveModalLabel">@(Model.IsMyDeck ? "Save" : "Create") Deck</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="alert alert-danger d-none" id="apiError" role="alert">
                    <div class="d-flex align-items-start">
                        <div class="me-3 fs-4">⚠️</div>

                        <div class="flex-grow-1">
                            <h5 class="alert-heading mb-1" id="apiErrorTitle">
                                Validation error
                            </h5>

                            <p class="mb-2" id="apiErrorMessage"></p>

                            <ul class="mb-0" id="apiErrorList"></ul>
                        </div>

                        <button type="button"
                                class="btn-close"
                                aria-label="Close"
                                onclick="document.getElementById('apiError').classList.add('d-none')">
                        </button>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="deckName" class="form-label">
                        Deck Name
                    </label>
                    <input class="form-control"
                                id="deckName"
                                name="DeckName"
                                maxlength="100"
                                value="@Model.DeckName"
                                placeholder="Enter a deck name..." />
                </div>
                <div class="mb-3">
                    <label for="deckDescription" class="form-label">
                        Description
                    </label>
                    <textarea class="form-control"
                              id="deckDescription"
                              name="Description"
                              rows="3"
                              maxlength="400"
                              placeholder="Enter a description...">@Model.Description</textarea>
                </div>
                <div class="mb-3">
                    <label for="deckVisibility" class="form-label">
                        Visibility
                    </label>
                    <select class="form-select"
                            id="deckVisibility"
                            name="Visibility">
                        <option value="@((int)DeckVisibility.Visible)" selected="@(Model.Visibility == DeckVisibility.Visible)">Public</option>
                        <option value="@((int)DeckVisibility.Limited)" selected="@(Model.Visibility == DeckVisibility.Limited)">Unlisted</option>
                        <option value="@((int)DeckVisibility.Invisible)" selected="@(Model.Visibility == DeckVisibility.Invisible)">Private</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="deckIconCardId" class="form-label">
                        Icon Card
                    </label>
                    
                        <select class="form-select"
                        id="deckIconCardId"
                        name="IconCardId">
                        @if (Model.QueryDeck != null)
                        {
                                List<Card> allDeckCards = [Model.QueryDeck.Hero];
                                allDeckCards.AddRange(Model.QueryDeck.Cards);
                                allDeckCards.AddRange(Model.QueryDeck.Landscapes);
                            @foreach (var card in allDeckCards.Where(x => x != null).Distinct())
                            {
                                <option value="@card.Id" selected="@(Model.IconCard == card.Id)">
                                    @card.LatestRevision.Name
                                </option>
                            }
                        }
                        </select>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button" class="btn btn-primary" id="saveDatabaseButton">
                    Save Deck
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="./js/enums.js" asp-append-version="true"></script>
    <script src="./js/helpers.js" asp-append-version="true"></script>
    <script src="./js/deckStorage.js" asp-append-version="true"></script>
    <script src="./js/deckbuilder.rendering.js" asp-append-version="true"></script>
    <script src="./js/deckbuilder.handlers.js" asp-append-version="true"></script>
    <script src="./js/filter.js" asp-append-version="true"></script>
    <script src="./js/sort.js" asp-append-version="true"></script>
    <script src="./js/lazy-card.js" asp-append-version="true"></script>

    <script>
        var deck = {
            hero: null,
            landscapes: [],
            cards: []
        };

        buildDeckIfExistsInQuery();

        document.getElementById("saveDatabaseButton").onclick = async function () {
            const alert = document.getElementById('apiError');

            const token = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            ).value;

            const params = new URLSearchParams(window.location.search);
            const deckId = params.get('id');

            const visibility = parseInt(document.getElementById("deckVisibility").value, 10);
            const description = document.getElementById("deckDescription").value;
            const deckName = document.getElementById("deckName").value;
            const iconId = document.getElementById("deckIconCardId").value;

            const response = await fetch('/api/Deck', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    deckContent: deckToString(),
                    visibility: visibility,
                    description: description,
                    iconId: iconId == "" ? -1 : parseInt(iconId),
                    deckName: deckName,
                    deckId: deckId
                })
            });

            const result = await response.json();

            if (!response.ok) {
                const title = document.getElementById('apiErrorTitle');
                const list = document.getElementById('apiErrorList');

                title.textContent = result.title || 'Something went wrong';

                list.innerHTML = '';

                if (result.errors) {
                    for (const [field, messages] of Object.entries(result.errors)) {
                        for (const msg of messages) {
                            const li = document.createElement('li');

                            const strong = document.createElement('strong');
                            strong.textContent = field + ': ';

                            li.appendChild(strong);
                            li.appendChild(document.createTextNode(msg));

                            list.appendChild(li);
                        }
                    }
                }

                alert.classList.remove('d-none');
            }
            else {
                alert(result.message);
                const modalElement = document.getElementById('saveModal');
                const modal = bootstrap.Modal.getInstance(modalElement);

                modal.hide();
                alert.classList.add('d-none');
            }
        }

        document.getElementById('saveModal').addEventListener('hidden.bs.modal', function () {
            const alert = document.getElementById('apiError');
            alert.classList.add('d-none');
        });
    </script>
}

@section Styles {
    <link rel="stylesheet" href="./css/deckbuilder.css" asp-append-version="true" />
    <link rel="stylesheet" href="./css/custom-checkbox.css" asp-append-version="true" />
    <link rel="stylesheet" href="./css/lazy-card.css" asp-append-version="true" />
}
