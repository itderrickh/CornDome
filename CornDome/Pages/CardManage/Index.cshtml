@page
@model CornDome.Pages.CardManage.IndexModel

@{
    ViewData["Title"] = "Card Manager";
}

<div class="container py-4 card-manager-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-primary fw-semibold small text-uppercase mb-2">
                CardDweeb / <a asp-page="/Admin/Index">Administration</a> / <a asp-page="/CardManage/Index">Card Management</a>
            </div>


            <div class="d-flex align-items-center gap-3">
                <div class="card-manager-icon">
                    <i class="bi bi-collection-fill"></i>
                </div>
                <div>
                    <h1 class="fw-bold mb-1">Card Management</h1>
                    <p class="text-muted mb-0">Manage and maintain the Card Dweeb database.</p>
                </div>
            </div>
        </div>

        <a asp-page="/CardManage/Add" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-lg me-2"></i>Add Card
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Summary -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="darklands-stat-icon bg-primary-subtle text-primary">
                        <i class="bi bi-collection"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">TOTAL CARDS</div>
                        <div class="fs-3 fw-bold">@Model.Cards.Count()</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="darklands-stat-icon bg-success-subtle text-success">
                        <i class="bi bi-tags"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Regular Cards</div>
                        <div class="fs-3 fw-bold">
                            @Model.Cards.Where(c => !c.IsCustomCard).Distinct().Count()
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="darklands-stat-icon bg-warning-subtle text-warning">
                        <i class="bi bi-shield-shaded"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Custom Cards</div>
                        <div class="fs-3 fw-bold">
                            @Model.Cards.Where(c => c.IsCustomCard).Distinct().Count()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-manager-table shadow-sm">
        <div class="card-header bg-transparent border-0 p-3 p-md-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <span class="text-muted small">
                        <span id="visibleCardCount">@Model.Cards.Count()</span> cards
                    </span>
                </div>

                <div class="card-search">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           class="form-control"
                           id="nameFilter"
                           placeholder="Search cards..."
                           autocomplete="off" />
                    <button type="button" id="clearFilter" class="btn btn-sm" title="Clear search" aria-label="Clear search">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 card-manager-list">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 90px;">ID</th>
                        <th>Name</th>
                        <th class="text-end pe-4" style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var card in Model.Cards)
                    {
                        <tr data-name="@card.Name" class="card-row">
                            <td class="ps-4 text-muted small">@card.Id</td>
                            <td>
                                <a asp-page="/Card" asp-route-id="@card.Id" class="card-name-link fw-semibold">
                                    @card.Name
                                </a>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-page="/CardManage/Edit"
                                       asp-route-id="@card.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Edit card">
                                        <i class="bi bi-pencil-square"></i>
                                        <span class="d-none d-md-inline ms-1">Edit</span>
                                    </a>

                                    @if (UserRoleHelper.IsAdmin(User))
                                    {
                                        <form asp-page-handler="DeleteCard"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this card?');">
                                            <input type="hidden" name="DeleteCardId" value="@card.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Delete card">
                                                <i class="bi bi-trash"></i>
                                                <span class="d-none d-md-inline ms-1">Delete</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div id="noCardsFound" class="text-center py-5 d-none">
                <i class="bi bi-search display-5 text-muted"></i>
                <h5 class="mt-3 fw-semibold">No cards found</h5>
                <p class="text-muted mb-0">Try adjusting your search.</p>
            </div>

            @if (!Model.Cards.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-collection display-5 text-muted"></i>
                    <h5 class="mt-3 fw-semibold">No cards yet</h5>
                    <p class="text-muted mb-3">Get started by adding your first card.</p>
                    <a asp-page="/CardManage/Add" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>Add Your First Card
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cardManage/index.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/cardManage/index.css" asp-append-version="true" />
}
