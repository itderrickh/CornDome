@page
@model CornDome.Pages.CardManage.IndexModel
@{
    ViewData["Title"] = "Card Manager";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-primary fw-semibold small text-uppercase mb-2">
                CardDweeb / <a asp-page="/Admin/Index">Administration</a> / <a asp-page="/CardManage/Index">Card Management</a>
            </div>
            <h1 class="fw-bold mb-2">Card Management</h1>
            <p class="text-muted mb-0">
                Manage Cards in the CardDweeb database.
            </p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="tab-content mt-3" id="myTabContent">
        <div class="tab-pane fade show active" id="edit-cards" role="tabpanel" aria-labelledby="edit-cards-tab">
            <div class="mb-2">
                <a asp-page="/CardManage/Add" class="btn btn-primary">Add a Card</a>
            </div>
            <div class="filter-group">
                <label for="nameFilter" class="filter-label">Filter: </label>
                <input type="text" class="form-control" id="nameFilter" />
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var card in Model.Cards)
                    {
                        <tr data-name="@card.LatestRevision.Name" class="card-row">
                            <td>@card.Id</td>
                            <td><a asp-page="/Card" asp-route-id="@card.Id">@card.LatestRevision.Name</a></td>
                            <td>
                                <a class="btn btn-primary" asp-page="/CardManage/Edit" asp-route-id="@card.Id">Edit</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-page-handler="DeleteCard" class="mt-2" onsubmit="return confirm('Are you sure you want to delete this card?');">
                                        <input type="text" name="DeleteCardId" value="@card.Id" class="d-none" />
                                        <button type="submit" class="btn btn-danger">Delete Card</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Darklands Cards -->
        <div class="tab-pane fade" id="darklands-cards" role="tabpanel" aria-labelledby="darklands-cards-tab">
            <div class="mb-2">
                <a asp-page="/Darklands/Add" class="btn btn-primary">Add a Darklands Card</a>
            </div>

            <fieldset class="mb-3">
                <legend>Filters</legend>
                <div class="filter-group">
                    <label for="darklandsNameFilter" class="filter-label">Name: </label>
                    <input type="text" class="form-control" id="darklandsNameFilter" />
                </div>
            </fieldset>

            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Card Type</th>
                        <th>Overlord</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var card in Model.DarklandsCards)
                    {
                        <tr data-name="@card.Name" class="darklands-card-row">
                            <td>@card.Id</td>
                            <td>
                                <a asp-page="/Darklands/Card" asp-route-id="@card.Id">@card.Name</a>
                            </td>
                            <td>@card.CardType?.Description</td>
                            <td>@card.Overlord?.Description</td>
                            <td>
                                <a class="btn btn-primary" asp-page="/Darklands/Edit" asp-route-id="@card.Id">Edit</a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-page-handler="DeleteDarklandsCard" class="mt-2"
                                          onsubmit="return confirm('Are you sure you want to delete this Darklands card?');">
                                        <input type="hidden" name="DeleteDarklandsCardId" value="@card.Id" />
                                        <button type="submit" class="btn btn-danger">Delete Card</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cardManage/index.js" asp-append-version="true"></script>
    <script src="~/js/cardManage/darklands-index.js" asp-append-version="true"></script>
    <script>
        document.getElementById("darklandsNameFilter").oninput = function () {
            const filter = this.value.toLowerCase();

            document.querySelectorAll(".darklands-card-row").forEach(row => {
                const name = (row.dataset.name || "").toLowerCase();
                row.style.display = name.includes(filter) ? "" : "none";
            });
        };
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/cardManage/index.css" asp-append-version="true" />
}