@page
@model CornDome.Pages.CardManage.EditModel
@{
    ViewData["Title"] = "Edit Card";
}

<div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="CardId" />
        <input type="hidden" asp-for="EditCard.RevisionId" />
        <div class="form-group mb-1">
            <label>Name: </label><input type="text" class="form-control" asp-for="EditCard.Name" />
        </div>

        <div class="form-group mb-1">
            <label>Card Type: </label>
            <select class="form-control cardType" asp-for="EditCard.TypeId">
                <option value="@((int)CardTypeEnum.Creature)">Creature</option>
                <option value="@((int)CardTypeEnum.Spell)">Spell</option>
                <option value="@((int)CardTypeEnum.Building)">Building</option>
                <option value="@((int)CardTypeEnum.Landscape)">Landscape</option>
                <option value="@((int)CardTypeEnum.Hero)">Hero</option>
                <option value="@((int)CardTypeEnum.Teamwork)">Teamwork</option>
            </select>
        </div>

        <div id="optionalFields">
            <div class="form-group mb-1 landscapeField">
                <label>Landscape: </label>
                <select class="form-control" asp-for="EditCard.LandscapeId">
                    <option value="@null">-- Select a Landscape --</option>
                    <option value="@((int)LandscapeEnum.BluePlains)">@LandscapeConverter.ToString(LandscapeEnum.BluePlains)</option>
                    <option value="@((int)LandscapeEnum.CornField)">@LandscapeConverter.ToString(LandscapeEnum.CornField)</option>
                    <option value="@((int)LandscapeEnum.UselessSwamp)">@LandscapeConverter.ToString(LandscapeEnum.UselessSwamp)</option>
                    <option value="@((int)LandscapeEnum.SandyLands)">@LandscapeConverter.ToString(LandscapeEnum.SandyLands)</option>
                    <option value="@((int)LandscapeEnum.NiceLands)">@LandscapeConverter.ToString(LandscapeEnum.NiceLands)</option>
                    <option value="@((int)LandscapeEnum.IcyLands)">@LandscapeConverter.ToString(LandscapeEnum.IcyLands)</option>
                    <option value="@((int)LandscapeEnum.Rainbow)">@LandscapeConverter.ToString(LandscapeEnum.Rainbow)</option>
                    <option value="@((int)LandscapeEnum.LavaFlats)">@LandscapeConverter.ToString(LandscapeEnum.LavaFlats)</option>
                </select>
            </div>

            <div class="form-group mb-1 abilityField">
                <label>Ability: </label>
                <input type="text" class="form-control" asp-for="EditCard.Ability" />
            </div>
            <div class="form-group mb-1 setField">
                <label>Set: </label>
                <div class="tag-container" id="tagContainer">
                    <input type="text" id="tag-input" placeholder="Add set..." />
                </div>
                <div class="tag-dropdown" id="tag-dropdown"></div>
                <input type="hidden" asp-for="SetIds" id="setIdsInput" />
            </div>
            <div class="form-group mb-1 costField">
                <label>Cost: </label>
                <input type="number" class="form-control" asp-for="EditCard.Cost" />
            </div>
            <div class="form-group mb-1 attackField">
                <label>Attack: </label>
                <input type="number" class="form-control" asp-for="EditCard.Attack" />
            </div>
            <div class="form-group mb-1 defenseField">
                <label>Defense: </label>
                <input type="number" class="form-control" asp-for="EditCard.Defense" />
            </div>
        </div>

        <div class="form-group mb-1 imageField">
            <div class="row">
                <h3>Image Editing:</h3>
                @* Only show the regular image for posting *@
                <div class="col-6 preview-box">
                    <h4>Old Image</h4>
                    <img class="oldPreview" src="@(Model.BaseUrl + Model.EditCard.ImageUrl)" alt="Old Card">
                </div>

                <div class="col-6 preview-box">
                    <h4>New Image</h4>
                    <img class="newPreview" src="" alt="Preview">
                    <div class="upload-section">
                        <input type="file" asp-for="RevisionImageUpload.File" class="fileInput" accept="image/*">
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-2">
            <button type="submit" class="btn btn-primary">
                Submit
            </button>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/cardManage/edit.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/setTag.css" asp-append-version="true" />
}

@section Scripts {
    @* This isn't meant to be super secure. Only as a way to allow me to make data edits *@
    @if (User.IsInRole("Admin"))
    {
        <script>
            var isAdmin = true;
        </script>
    }
    else
    {
        <script>
            var isAdmin = false;
        </script>
    }

    <script src="~/js/cardManage/edit.js" asp-append-version="true"></script>
    <script>
        const allSets = JSON.parse('@Json.Serialize(Model.AllSets)');
        const selected = JSON.parse('@Json.Serialize(Model.EditCard.CardSets)');
    </script>
    <script src="~/js/setTag.js" asp-append-version="true"></script>
}