@page
@model CornDome.Pages.DeckModel
@{
    ViewData["Title"] = "Deck";
    var user = await Model.GetUser();
}

@if (Model.QueryDeck == null)
{
    <h1>Invalid Deck.</h1>
}
else
{
    @Html.AntiForgeryToken()
    ViewData["RenderMode"] = "wide";
    var totalCost = Model.QueryDeck.Cards.Select(x => x.Cost).Sum();

    decimal averageCost = 0;

    if (Model.QueryDeck.Cards.Count > 0)
    {
        averageCost = (decimal)totalCost / (decimal)Model.QueryDeck.Cards.Count;
    }

    @if (Model.DbDeck != null)
    {
        <div class="container">
            <div class="row">
                <div class="col">
                    <h2><i>@Model.DbDeck.DeckName</i></h2>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <p>@Model.DbDeck.Description</p>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <h5><u>Author:</u> <i><a asp-page="/Decks/User" asp-route-userId="@Model.AuthorId">@Model.Author</a></i></h5>
                </div>
            </div>
            <div class="row mb-4">
                <div class="col-1">
                    <a href="#deckComments" style="color: inherit; text-decoration: inherit;"><span class="mr-1">@Model.DbDeck.DeckComments.Count()</span> <i class="bi bi-chat"></i></a>
                </div>
                <div class="col-1">
                    <span class="mr-1 like-count">@Model.DbDeck.DeckLikes.Where(x => x.Liked).Count()</span> 
                    <i class="bi like-icon @(Model.DbDeck.DeckLikes.Any(x => x.UserId == user.Id && x.Liked) ? "bi-hand-thumbs-up-fill liked" : "bi-hand-thumbs-up")"
                        data-deck-id="@Model.DbDeck.Id"
                        role="button"
                        title="Like this deck"
                        aria-label="Like this deck"
                        aria-pressed="@Model.DbDeck.DeckLikes.Any(x => x.UserId == user.Id && x.Liked)"></i>
                </div>
                <div class="col-1">
                    <span class="mr-1">@Model.DbDeck.Views</span> <i class="bi bi-eye"></i>
                </div>
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="col-1">
                        <i class="bi bi-floppy save-icon" data-bs-toggle="modal" data-bs-target="#saveModal" style="cursor: pointer;"></i>
                    </div>
                }
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-2 col-sm-2">
            <button class="btn btn-primary btn-block" id="showStats" onclick="showStats()">Show Stats And Actions</button>
            <fieldset id="statsSection" class="stats">
                <h3>Deck Breakdown</h3>
                <div><span class="info-stamp" title="The minimum deck limit is 40 cards."></span> Total Cards: <span id="total-stat">@Model.QueryDeck.Cards.Count</span></div>
                <br />
                <div><span class="info-stamp" title="Only 1 Hero is allowed per deck."></span> Heroes: <span id="heroes-stat">@(Model.QueryDeck.Hero != null ? "1" : "0")</span></div>
                <div><span class="info-stamp" title="Only 4 Landscapes are allowed per deck."></span> Landscapes: <span id="landscapes-stat">@Model.QueryDeck.Landscapes.Count()</span></div>
                <div><span class="info-stamp" title="You can have as many creatures as you like."></span> Creatures: <span id="creature-stat">@Model.QueryDeck.Cards.Where(x => x.TypeId == (int)CardTypeEnum.Creature).Count()</span></div>
                <div><span class="info-stamp" title="You can have as many spells as you like."></span> Spells: <span id="spell-stat">@Model.QueryDeck.Cards.Where(x => x.TypeId == (int)CardTypeEnum.Spell).Count()</span></div>
                <div><span class="info-stamp" title="You can have as many buildings as you like."></span> Buildings: <span id="building-stat">@Model.QueryDeck.Cards.Where(x => x.TypeId == (int)CardTypeEnum.Building).Count()</span></div>
                <div><span class="info-stamp" title="You can have as many teamworks as you like."></span> Teamworks: <span id="teamwork-stat">@Model.QueryDeck.Cards.Where(x => x.TypeId == (int)CardTypeEnum.Teamwork).Count()</span></div>
                <hr />
                <div>Average Cost: <span id="average-cost">@averageCost.ToString("F2")</span></div>
                <div>Total Cost: <span id="total-cost">@totalCost</span></div>
                <hr />
                <h3>Landscape Ratios</h3>
                <div>Blue Plains: <span id="bp-stat">@Model.QueryDeck.Cards.Where(x => x.LandscapeId == (int)LandscapeEnum.BluePlains).Count()</span></div>
                <div>Cornfield: <span id="cf-stat">@Model.QueryDeck.Cards.Where(x => x.LandscapeId == (int)LandscapeEnum.CornField).Count()</span></div>
                <div>Useless Swamp: <span id="us-stat">@Model.QueryDeck.Cards.Where(x => x.LandscapeId == (int)LandscapeEnum.UselessSwamp).Count()</span></div>
                <div>SandyLands: <span id="sl-stat">@Model.QueryDeck.Cards.Where(x => x.LandscapeId == (int)LandscapeEnum.SandyLands).Count()</span></div>
                <div>NiceLands: <span id="nl-stat">@Model.QueryDeck.Cards.Where(x => x.LandscapeId == (int)LandscapeEnum.NiceLands).Count()</span></div>
                <div>IcyLands: <span id="il-stat">@Model.QueryDeck.Cards.Where(x => x.LandscapeId == (int)LandscapeEnum.IcyLands).Count()</span></div>
                <div>Rainbow: <span id="rb-stat">@Model.QueryDeck.Cards.Where(x => x.LandscapeId == (int)LandscapeEnum.Rainbow).Count()</span></div>
                <div>LavaFlats: <span id="lf-stat">@Model.QueryDeck.Cards.Where(x => x.LandscapeId == (int)LandscapeEnum.LavaFlats).Count()</span></div>
            </fieldset>

            <fieldset id="actionsSection">
                <legend>Actions</legend>
                <a class="btn btn-lg btn-block btn-primary" asp-page="DeckBuilder" asp-route-deck="@Model.NonGZDeck" asp-route-gzdeck="@(Model.GzDeck)" asp-route-id="@(Model.DeckId)">Go To Deck Builder</a>
                <a class="btn btn-lg btn-block btn-primary" asp-page="Download" asp-route-deck="@Model.NonGZDeck" asp-route-gzdeck="@(Model.GzDeck)" asp-route-id="@(Model.DeckId)">Download Image</a>
                <a class="btn btn-lg btn-block btn-primary" asp-page="/Printer/PDF" asp-route-deck="@(Model.NonGZDeck)" asp-route-gzdeck="@(Model.GzDeck)" asp-route-id="@(Model.DeckId)">Print as PDF</a>
            </fieldset>
        </div>
        <div class="col-md-8 col-sm-8">
            @if (Model.QueryDeck != null)
            {
                <div class="d-flex">
                    @if (Model.QueryDeck.Hero != null)
                    {
                        <div class="w-20">
                            <a asp-page="/Card" asp-route-id="@Model.QueryDeck.Hero.Id" class="deck-card" data-card-id="@Model.QueryDeck.Hero.Id" data-type="hero">
                                <img class="w-100" alt="@Model.QueryDeck.Hero.Name" src="@(Model.BaseUrl + Model.QueryDeck.Hero.GetOptimizedImage)" />
                            </a>
                        </div>
                    }

                    @foreach (var landscape in Model.QueryDeck.Landscapes.Where(x => x != null))
                    {
                        <div class="w-20">
                            <a asp-page="/Card" asp-route-id="@landscape.Id" class="deck-card" data-card-id="@landscape.Id" data-type="landscape">
                                <img class="w-100" alt="@landscape.Name" src="@(Model.BaseUrl + landscape.GetOptimizedImage)" />
                            </a>
                        </div>
                    }
                </div>

                <div class="d-flex flex-wrap">
                    @foreach (var card in Model.QueryDeck.Cards.Where(x => x != null).OrderBy(x => x.Name))
                    {
                        <div class="w-10">
                            <a asp-page="/Card" asp-route-id="@card.Id" class="deck-card" data-card-id="@card.Id" data-type="card">
                                <img class="deck-card-image w-100" alt="@card.Name" src="@(Model.BaseUrl + card.GetOptimizedImage)" />
                            </a>
                        </div>
                    }
                </div>

                <style>
                    .deck-card-image:hover {
                        transform: scale(2);
                        transition: transform .2s;
                    }
                </style>
            }
        </div>
    </div>

    @if (Model.DbDeck != null)
    {
        <div class="mt-4">
            <hr />
        </div>

        <div class="container">
            <section class="deck-comments" id="deckComments">
                <div class="comments-header">
                    <h3>
                        <i class="bi bi-chat-square-text"></i>
                        Deck Discussion
                        <span class="comment-count" id="commentCount">(@(Model.DbDeck.DeckComments?.Count ?? 0))</span>
                    </h3>

                    <select id="commentSort" class="comment-sort">
                        <option value="newest">Newest first</option>
                        <option value="oldest">Oldest first</option>
                    </select>
                </div>

                @if (User.Identity.IsAuthenticated)
                {
                    <!-- New comment -->
                    <div class="comment-composer">
                        <div class="comment-avatar">@user.UserName.FirstOrDefault()</div>
                        <div class="composer-content">
                            <textarea id="commentInput"
                                      placeholder="What do you think about this deck?"
                                      rows="2"></textarea>

                            <div class="composer-footer">
                                <span class="composer-hint">
                                    Be respectful and keep it constructive.
                                </span>
                                <button id="postComment" class="comment-submit">
                                    Post Comment
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p>Login to comment</p>
                }

                <div id="comment-list" data-deck-id="@Model.DbDeck.Id">
                
                    <div class="comment-replies">
                        @foreach (var comment in Model.DbDeck.DeckComments.OrderByDescending(x => x.Timestamp))
                        {
                            <div class="comment-reply">
                                <div class="comment-avatar" style="background:#6551a5">
                                    @comment.User.UserName.FirstOrDefault()
                                </div>
                                <div class="comment-body">
                                    <div class="comment-meta">
                                        <span class="comment-author">@comment.User.UserName</span>
                                        <span class="comment-time">@comment.Timestamp.ToString("MMM dd, yyyy h:mm tt")</span>
                                    </div>
                                    <div class="comment-text">@comment.CommentText</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    }
    
    <!-- Create / Edit Deck Modal -->
    <div class="modal fade" id="saveModal" tabindex="-1" aria-labelledby="saveModalLabel" aria-hidden="true" style="color: black;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="saveModalLabel">@(Model.IsMyDeck ? "Save" : "Create") Deck</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="alert alert-danger d-none" id="apiError" role="alert">
                        <div class="d-flex align-items-start">
                            <div class="me-3 fs-4">⚠️</div>

                            <div class="flex-grow-1">
                                <h5 class="alert-heading mb-1" id="apiErrorTitle">
                                    Validation error
                                </h5>

                                <p class="mb-2" id="apiErrorMessage"></p>

                                <ul class="mb-0" id="apiErrorList"></ul>
                            </div>

                            <button type="button"
                                    class="btn-close"
                                    aria-label="Close"
                                    onclick="document.getElementById('apiError').classList.add('d-none')">
                            </button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="deckName" class="form-label">
                            Deck Name
                        </label>
                        <input class="form-control"
                                  id="deckName"
                                  name="DeckName"
                                  maxlength="100"
                                  value="@Model.DeckName"
                                  placeholder="Enter a deck name..." />
                    </div>
                    <div class="mb-3">
                        <label for="deckDescription" class="form-label">
                            Description
                        </label>
                        <textarea class="form-control"
                                  id="deckDescription"
                                  name="Description"
                                  rows="3"
                                  maxlength="400"
                                  placeholder="Enter a description...">@Model.Description</textarea>
                    </div>
                    <div class="mb-3">
                        <label for="deckVisibility" class="form-label">
                            Visibility
                        </label>
                        <select class="form-select"
                                id="deckVisibility"
                                name="Visibility">
                            <option value="@((int)DeckVisibility.Visible)" selected="@(Model.Visibility == DeckVisibility.Visible)">Public</option>
                            <option value="@((int)DeckVisibility.Limited)" selected="@(Model.Visibility == DeckVisibility.Limited)">Unlisted</option>
                            <option value="@((int)DeckVisibility.Invisible)" selected="@(Model.Visibility == DeckVisibility.Invisible)">Private</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="deckIconCardId" class="form-label">
                            Icon Card
                        </label>

                        <select class="form-select"
                                id="deckIconCardId"
                                name="IconCardId">
                            @{
                                List<Card> allDeckCards = [Model.QueryDeck.Hero];
                                allDeckCards.AddRange(Model.QueryDeck.Cards);
                                allDeckCards.AddRange(Model.QueryDeck.Landscapes);
                            }
                            @foreach (var card in allDeckCards.Where(x => x != null).Distinct())
                            {
                                <option value="@card.Id" selected="@(Model.IconCard == card.Id)">
                                    @card.Name
                                </option>
                            }
                        </select>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button" class="btn btn-primary" id="saveDatabaseButton">
                        Save Deck
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/deck.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}

@section Scripts {
    <script>
        var userId = @user.Id;
        var comments = JSON.parse('@(Json.Serialize(Model.DbDeck.DeckComments))');
    </script>
    <script src="~/js/enums.js" asp-append-version="true"></script>
    <script src="~/js/helpers.js" asp-append-version="true"></script>
    <script src="~/js/deckStorage.js" asp-append-version="true"></script>
    <script src="~/js/deck.js" asp-append-version="true"></script>
    <script src="~/js/deckcomments.js" asp-append-version="true"></script>
}