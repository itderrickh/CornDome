@page
@model CornDome.Pages.DeckModel
@{
    ViewData["Title"] = "Deck";
}

@if (Model.QueryDeck == null)
{
    <h1>Invalid Deck.</h1>
}
else
{
    @Html.AntiForgeryToken()
    ViewData["RenderMode"] = "wide";
    var totalCost = Model.QueryDeck.Cards.Select(x => x.LatestRevision.Cost).Sum();

    decimal averageCost = 0;

    if (Model.QueryDeck.Cards.Count > 0)
    {
        averageCost = (decimal)totalCost / (decimal)Model.QueryDeck.Cards.Count;
    }

    <div class="row">
        <div class="col-md-2 col-sm-2">
            <button class="btn btn-primary btn-block" id="showStats" onclick="showStats()">Show Stats And Actions</button>
            <fieldset id="statsSection" class="stats">
                <h3>Deck Breakdown</h3>
                <div><span class="info-stamp" title="The minimum deck limit is 40 cards."></span> Total Cards: <span id="total-stat">@Model.QueryDeck.Cards.Count</span></div>
                <br />
                <div><span class="info-stamp" title="Only 1 Hero is allowed per deck."></span> Heroes: <span id="heroes-stat">@(Model.QueryDeck.Hero != null ? "1" : "0")</span></div>
                <div><span class="info-stamp" title="Only 4 Landscapes are allowed per deck."></span> Landscapes: <span id="landscapes-stat">@Model.QueryDeck.Landscapes.Count()</span></div>
                <div><span class="info-stamp" title="You can have as many creatures as you like."></span> Creatures: <span id="creature-stat">@Model.QueryDeck.Cards.Where(x => x.LatestRevision.TypeId == (int)CardTypeEnum.Creature).Count()</span></div>
                <div><span class="info-stamp" title="You can have as many spells as you like."></span> Spells: <span id="spell-stat">@Model.QueryDeck.Cards.Where(x => x.LatestRevision.TypeId == (int)CardTypeEnum.Spell).Count()</span></div>
                <div><span class="info-stamp" title="You can have as many buildings as you like."></span> Buildings: <span id="building-stat">@Model.QueryDeck.Cards.Where(x => x.LatestRevision.TypeId == (int)CardTypeEnum.Building).Count()</span></div>
                <div><span class="info-stamp" title="You can have as many teamworks as you like."></span> Teamworks: <span id="teamwork-stat">@Model.QueryDeck.Cards.Where(x => x.LatestRevision.TypeId == (int)CardTypeEnum.Teamwork).Count()</span></div>
                <hr />
                <div>Average Cost: <span id="average-cost">@averageCost.ToString("F2")</span></div>
                <div>Total Cost: <span id="total-cost">@totalCost</span></div>
                <hr />
                <h3>Landscape Ratios</h3>
                <div>Blue Plains: <span id="bp-stat">@Model.QueryDeck.Cards.Where(x => x.LatestRevision.LandscapeId == (int)LandscapeEnum.BluePlains).Count()</span></div>
                <div>Cornfield: <span id="cf-stat">@Model.QueryDeck.Cards.Where(x => x.LatestRevision.LandscapeId == (int)LandscapeEnum.CornField).Count()</span></div>
                <div>Useless Swamp: <span id="us-stat">@Model.QueryDeck.Cards.Where(x => x.LatestRevision.LandscapeId == (int)LandscapeEnum.UselessSwamp).Count()</span></div>
                <div>SandyLands: <span id="sl-stat">@Model.QueryDeck.Cards.Where(x => x.LatestRevision.LandscapeId == (int)LandscapeEnum.SandyLands).Count()</span></div>
                <div>NiceLands: <span id="nl-stat">@Model.QueryDeck.Cards.Where(x => x.LatestRevision.LandscapeId == (int)LandscapeEnum.NiceLands).Count()</span></div>
                <div>IcyLands: <span id="il-stat">@Model.QueryDeck.Cards.Where(x => x.LatestRevision.LandscapeId == (int)LandscapeEnum.IcyLands).Count()</span></div>
                <div>Rainbow: <span id="rb-stat">@Model.QueryDeck.Cards.Where(x => x.LatestRevision.LandscapeId == (int)LandscapeEnum.Rainbow).Count()</span></div>
                <div>LavaFlats: <span id="lf-stat">@Model.QueryDeck.Cards.Where(x => x.LatestRevision.LandscapeId == (int)LandscapeEnum.LavaFlats).Count()</span></div>
            </fieldset>

            <fieldset id="actionsSection">
                <legend>Actions</legend>
                <a class="btn btn-lg btn-block btn-primary" asp-page="DeckBuilder" asp-route-deck="@Model.NonGZDeck" asp-route-gzdeck="@(Model.GzDeck)" asp-route-id="@(Model.DeckId)">Go To Deck Builder</a>
                <a class="btn btn-lg btn-block btn-primary" asp-page="Download" asp-route-deck="@Model.NonGZDeck" asp-route-gzdeck="@(Model.GzDeck)" asp-route-id="@(Model.DeckId)">Download Image</a>
                @if (User.Identity.IsAuthenticated)
                {
                    <button type="button" class="btn btn-lg btn-block btn-primary" data-bs-toggle="modal" data-bs-target="#saveModal">Save Deck</button>
                }
                else
                {
                    <button id="disabledSave" type="button" class="btn btn-lg btn-block btn-secondary btn-disabled" disabled>
                        Login to Save Decks
                    </button>
                }
                
            </fieldset>
        </div>
        <div class="col-md-10 col-sm-10">
            <div class="row p-1">
                <div class="col-8">
                    <h5>@Model.Description</h5>
                </div>
                <div class="col-4 text-end">
                    <h4><u>Deck Name:</u> <i>@Model.DeckName</i></h4>
                    <h4><u>Author:</u> <i><a asp-page="/Decks/User" asp-route-userId="@Model.AuthorId">@Model.Author</a></i></h4>
                </div>
            </div>
            @if (Model.QueryDeck != null)
            {
                <div class="d-flex">
                    @if (Model.QueryDeck.Hero != null)
                    {
                        <div class="w-20">
                            <a asp-page="/Card" asp-route-id="@Model.QueryDeck.Hero.Id" class="deck-card" data-card-id="@Model.QueryDeck.Hero.Id" data-type="hero">
                                <img class="w-100" alt="@Model.QueryDeck.Hero.LatestRevision.Name" src="@(Model.BaseUrl + Model.QueryDeck.Hero.LatestRevision.GetOptimizedImage)" />
                            </a>
                        </div>
                    }

                    @foreach (var landscape in Model.QueryDeck.Landscapes.Where(x => x != null))
                    {
                        <div class="w-20">
                            <a asp-page="/Card" asp-route-id="@landscape.Id" class="deck-card" data-card-id="@landscape.Id" data-type="landscape">
                                <img class="w-100" alt="@landscape.LatestRevision.Name" src="@(Model.BaseUrl + landscape.LatestRevision.GetOptimizedImage)" />
                            </a>
                        </div>
                    }
                </div>

                <div class="d-flex flex-wrap">
                    @foreach (var card in Model.QueryDeck.Cards.Where(x => x != null).OrderBy(x => x.LatestRevision.Name))
                    {
                        <div class="w-10">
                            <a asp-page="/Card" asp-route-id="@card.Id" class="deck-card" data-card-id="@card.Id" data-type="card">
                                <img class="deck-card-image w-100" alt="@card.LatestRevision.Name" src="@(Model.BaseUrl + card.LatestRevision.GetOptimizedImage)" />
                            </a>
                        </div>
                    }
                </div>

                <style>
                            .deck-card-image:hover {
                                transform: scale(2);
                                transition: transform .2s;
                            }
                </style>
            }
        </div>
    </div>

    <!-- Create / Edit Deck Modal -->
    <div class="modal fade" id="saveModal" tabindex="-1" aria-labelledby="saveModalLabel" aria-hidden="true" style="color: black;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="saveModalLabel">@(Model.IsMyDeck ? "Save" : "Create") Deck</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="alert alert-danger d-none" id="apiError" role="alert">
                        <div class="d-flex align-items-start">
                            <div class="me-3 fs-4">⚠️</div>

                            <div class="flex-grow-1">
                                <h5 class="alert-heading mb-1" id="apiErrorTitle">
                                    Validation error
                                </h5>

                                <p class="mb-2" id="apiErrorMessage"></p>

                                <ul class="mb-0" id="apiErrorList"></ul>
                            </div>

                            <button type="button"
                                    class="btn-close"
                                    aria-label="Close"
                                    onclick="document.getElementById('apiError').classList.add('d-none')">
                            </button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="deckName" class="form-label">
                            Deck Name
                        </label>
                        <input class="form-control"
                                  id="deckName"
                                  name="DeckName"
                                  maxlength="100"
                                  value="@Model.DeckName"
                                  placeholder="Enter a deck name..." />
                    </div>
                    <div class="mb-3">
                        <label for="deckDescription" class="form-label">
                            Description
                        </label>
                        <textarea class="form-control"
                                  id="deckDescription"
                                  name="Description"
                                  rows="3"
                                  maxlength="400"
                                  placeholder="Enter a description...">@Model.Description</textarea>
                    </div>
                    <div class="mb-3">
                        <label for="deckVisibility" class="form-label">
                            Visibility
                        </label>
                        <select class="form-select"
                                id="deckVisibility"
                                name="Visibility">
                            <option value="@((int)DeckVisibility.Visible)" selected="@(Model.Visibility == DeckVisibility.Visible)">Public</option>
                            <option value="@((int)DeckVisibility.Limited)" selected="@(Model.Visibility == DeckVisibility.Limited)">Unlisted</option>
                            <option value="@((int)DeckVisibility.Invisible)" selected="@(Model.Visibility == DeckVisibility.Invisible)">Private</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="deckIconCardId" class="form-label">
                            Icon Card
                        </label>

                        <select class="form-select"
                                id="deckIconCardId"
                                name="IconCardId">
                            @{
                                List<Card> allDeckCards = [Model.QueryDeck.Hero];
                                allDeckCards.AddRange(Model.QueryDeck.Cards);
                                allDeckCards.AddRange(Model.QueryDeck.Landscapes);
                            }
                            @foreach (var card in allDeckCards.Where(x => x != null).Distinct())
                            {
                                <option value="@card.Id" selected="@(Model.IconCard == card.Id)">
                                    @card.LatestRevision.Name
                                </option>
                            }
                        </select>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button" class="btn btn-primary" id="saveDatabaseButton">
                        Save Deck
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/deck.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/enums.js" asp-append-version="true"></script>
    <script src="~/js/helpers.js" asp-append-version="true"></script>
    <script src="~/js/deckStorage.js" asp-append-version="true"></script>
    <script src="~/js/deck.js" asp-append-version="true"></script>
}