@page
@inject AppFlagHelper AppFlags
@model CornDome.Pages.Dweeble.IndexModel
@{
    ViewData["Title"] = "Dweeble";
    ViewData["RenderMode"] = "wide";
    var user = await Model.GetUser();
}

@Html.AntiForgeryToken()

<div class="dweeble-layout">
    <!-- Left advertisement -->
    <aside class="dweeble-ad dweeble-ad-left">
        @if (AppFlags.IsActive("EnableAds") && (user == null || !User.IsInRole("CoolGuy") || !User.IsInRole("Admin")))
        {
            <partial name="_BannerAd" />
        }
    </aside>
    
    
    <!-- Left advertisement -->
    <aside class="dweeble-ad dweeble-ad-top">
        @if (AppFlags.IsActive("EnableAds") && (user == null || !User.IsInRole("CoolGuy") || !User.IsInRole("Admin")))
        {
            <partial name="_BannerAd" />
        }
    </aside>

    <main class="daily-game">

        <div class="daily-header">
            <div>
                <h1>Dweeble</h1>
                <p>The daily game to guess a Card Wars card. Can you solve it?</p>
            </div>

            <div class="daily-number">
                <span>DAILY CHALLENGE</span>
                <strong id="dailyDate">Loading...</strong>
            </div>

        </div>

        @if (!User.Identity.IsAuthenticated)
        {
            <div class="daily-disclaimer">
                Your challenge will NOT be on the leaderboard unless you Login!
            </div>
        }

        <div class="daily-stats">
            <div>
                <span>MISTAKES</span>
                <strong id="mistakes">0 / 8</strong>
            </div>

            <div>
                <span>LETTERS GUESSED</span>
                <strong id="lettersGuessed">0</strong>
            </div>
        </div>

        <div class="daily-name-section" id="daily-name-section">
            <span class="daily-label">MYSTERY CARD</span>
            <div id="nameDisplay" class="daily-name">
                Loading...
            </div>
            <div id="cardDisplay">
                <img id="mysteryCard" src="" />
            </div>
        </div>

        <div class="daily-attributes">

            <div class="daily-attribute ability">
                <span>ABILITY</span>
                <div id="abilityDisplay">???</div>
            </div>

            <div class="daily-attribute">
                <span>LANDSCAPE</span>
                <div id="landscapeDisplay">???</div>
                <div class="attribute-input">
                    <select id="landscapeGuess">
                        <option value="None">None</option>
                        <option value="BluePlains">Blue Plains</option>
                        <option value="CornField">Cornfield</option>
                        <option value="UselessSwamp">Useless Swamp</option>
                        <option value="NiceLands">NiceLands</option>
                        <option value="IcyLands">IcyLands</option>
                        <option value="Rainbow">Rainbow</option>
                        <option value="LavaFlats">LavaFlats</option>
                    </select>
                    <button data-guess="landscape">Guess</button>
                </div>
            </div>

            <div class="daily-attribute">
                <span>COST (None is an option)</span>
                <div id="costDisplay">?</div>
                <div class="attribute-input">
                    <input id="costGuess"
                            placeholder="Guess cost..."
                            autocomplete="off" />
                    <button data-guess="cost">Guess</button>
                </div>
            </div>

            <div class="daily-attribute">
                <span>ATTACK (None is an option)</span>
                <div id="attackDisplay">?</div>
                <div class="attribute-input">
                    <input id="attackGuess"
                            placeholder="Guess attack..."
                            autocomplete="off" />
                    <button data-guess="attack">Guess</button>
                </div>
            </div>

            <div class="daily-attribute">
                <span>DEFENSE (None is an option)</span>
                <div id="defenseDisplay">?</div>
                <div class="attribute-input">
                    <input id="defenseGuess"
                            placeholder="Guess defense..."
                            autocomplete="off" />
                    <button data-guess="defense">Guess</button>
                </div>
            </div>

            <div class="daily-attribute">
                <span>CARD TYPE</span>
                <div id="typeDisplay">???</div>
                <div class="attribute-input">
                    <select id="typeGuess">
                        <option value="">- None -</option>
                        <option value="Creature">Creature</option>
                        <option value="Spell">Spell</option>
                        <option value="Building">Building</option>
                        <option value="Hero">Hero</option>
                        <option value="Landscape">Landscape</option>
                        <option value="Teamwork">Teamwork</option>
                    </select>
                    <button data-guess="type">Guess</button>
                </div>
            </div>

            <div class="daily-attribute">
                <span>GUESS FULL CARD NAME</span>
                <div id="cardNameDisplay">?</div>
                <div class="attribute-input">
                    <input id="cardNameGuess"
                           placeholder="Guess name..."
                           autocomplete="off" />
                    <button data-guess="cardName">Guess</button>
                </div>
            </div>

        </div>

        <div class="daily-keyboard-section">
            <span class="daily-label">GUESS THE CARD NAME</span>
            <div id="keyboard" class="daily-keyboard"></div>
        </div>

        <div id="gameMessage" class="daily-message"
                aria-live="polite">
            Good luck!
        </div>

        <div id="gameResult" class="daily-result"
                style="display:none">

            <h2 id="resultTitle"></h2>
            <p id="resultDescription"></p>

        </div>

        <div class="daily-footer row mb-2">
            
            <div class="col-6">
                <a asp-page="/Dweeble/Leaderboard" class="leaderboard-button">
                    Daily Leaderboard
                </a>
            </div>

            <div class="col-6">
                <a asp-page="/Dweeble/AllTimeLeaderboard" class="alltime-button">
                    All Time Leaderboard
                </a>
            </div>
        </div>

        <div class="daily-footer">
            <span>New Dweeble every day at midnight UTC. (<span id="countDownTimer">0:00</span> remaining)</span>
        </div>

    </main>

    
    <!-- Left advertisement -->
    <aside class="dweeble-ad dweeble-ad-right">
        @if (AppFlags.IsActive("EnableAds") && (user == null || !User.IsInRole("CoolGuy") || !User.IsInRole("Admin")))
        {
            <partial name="_BannerAd" />
        }
    </aside>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/dweeble/guess.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/dweeble/guess.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}