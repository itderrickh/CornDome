@page
@model CornDome.Pages.Dweeble.AllTimeLeaderboardModel
@{
    ViewData["Title"] = "All-Time Leaderboard";
}

<div class="container py-4">
    <div class="daily-leaderboard-page">

        <div class="leaderboard-page-header">
            <div>
                <span class="leaderboard-eyebrow">
                    Dweeble
                </span>

                <h1>All-Time Champions</h1>

                <p>
                    The players who have mastered the daily challenge.
                </p>
            </div>
        </div>

        <div class="leaderboard-summary">
            <div>
                <span>PLAYERS WITH WINS</span>
                <strong>@Model.TotalPlayers</strong>
            </div>

            <div>
                <span>TOTAL VICTORIES</span>
                <strong>@Model.TotalWins</strong>
            </div>
        </div>

        @if (Model.CurrentPlayer != null)
        {
            <div class="leaderboard-your-rank">
                <div>
                    <span>YOUR ALL-TIME RANK</span>
                    <strong>#@Model.CurrentPlayer.Rank</strong>
                </div>

                <div>
                    <span>TOTAL WINS</span>
                    <strong>@Model.CurrentPlayer.TotalWins</strong>
                </div>

                <div>
                    <span>LONGEST STREAK</span>
                    <strong>
                        @Model.CurrentPlayer.LongestStreak days
                    </strong>
                </div>

                <div>
                    <span>AVERAGE MISTAKES</span>
                    <strong>
                        @Model.CurrentPlayer.AverageMistakes.ToString("0.0")
                    </strong>
                </div>
            </div>
        }

        <div class="leaderboard-card">

            <div class="leaderboard-card-header">
                <h2>
                    <i class="bi bi-trophy-fill"></i>
                    Hall of Fame
                </h2>

                <span>TOP 50</span>
            </div>

            @if (!Model.Players.Any())
            {
                <div class="leaderboard-empty">
                    <i class="bi bi-trophy"></i>

                    <h3>No champions yet!</h3>

                    <p>
                        Complete a daily challenge to claim your place.
                    </p>

                    <a asp-page="/Dweeble/Index"
                       class="btn btn-warning">
                        Play Dweeble
                    </a>
                </div>
            }
            else
            {
                <div class="leaderboard-table-wrapper">
                    <table class="leaderboard-table">
                        <thead>
                            <tr>
                                <th>RANK</th>
                                <th>PLAYER</th>
                                <th>WINS</th>
                                <th>BEST STREAK</th>
                                <th>AVG. MISTAKES</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var player in Model.Players)
                            {
                                <tr class="@(player.IsCurrentPlayer
                                    ? "current-player" : "")">

                                    <td class="rank-cell">
                                        @if (player.Rank == 1)
                                        {
                                            <span>🥇</span>
                                        }
                                        else if (player.Rank == 2)
                                        {
                                            <span>🥈</span>
                                        }
                                        else if (player.Rank == 3)
                                        {
                                            <span>🥉</span>
                                        }
                                        else
                                        {
                                            <span>#@player.Rank</span>
                                        }
                                    </td>

                                    <td class="player-cell">
                                        @player.DisplayName
                                        @if (player.UserIcon == UserIcon.EarlyBacker)
                                        {
                                            <img src="~/img/pig.webp" style="height: 30px; width: 30px;" />
                                        }
                                        else if (player.UserIcon == UserIcon.CoolGuy)
                                        {
                                            <img src="~/img/logo-cool.png" style="height: 30px; width: 30px;" />
                                        }
                                        else if (player.UserIcon == UserIcon.Dweeb)
                                        {
                                            <img src="~/img/logo.png" style="height: 30px; width: 30px;" />
                                        }

                                        @if (player.IsCurrentPlayer)
                                        {
                                            <span class="you-badge">
                                                YOU
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <strong>@player.TotalWins</strong>
                                    </td>

                                    <td>
                                        <i class="bi bi-fire"
                                           style="color: #e99b43;"></i>
                                        @player.LongestStreak days
                                    </td>

                                    <td>
                                        @player.AverageMistakes.ToString("0.0")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>

        
        @if (Model.MonthlyLeaderboards.Any())
        {
            <div class="leaderboard-card mt-4">
                <div class="leaderboard-card-header">
                    <h2>
                        <i class="bi bi-calendar3"></i>
                        Monthly Champions
                    </h2>
                    <span>TOP 3 PER MONTH</span>
                </div>

                @foreach (var month in Model.MonthlyLeaderboards)
                {
                    <div class="p-3">
                        <h3 class="mb-3">
                            @month.Month.ToString("MMMM yyyy")
                        </h3>

                        <div class="leaderboard-table-wrapper">
                            <table class="leaderboard-table">
                                <thead>
                                    <tr>
                                        <th>RANK</th>
                                        <th>PLAYER</th>
                                        <th>WINS</th>
                                        <th>BEST STREAK</th>
                                        <th>AVG. MISTAKES</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var player in month.Players)
                                    {
                                        <tr>
                                            <td class="rank-cell">
                                                @if (player.Rank == 1)
                                                {
                                                    <span>🥇</span>
                                                }
                                                else if (player.Rank == 2)
                                                {
                                                    <span>🥈</span>
                                                }
                                                else if (player.Rank == 3)
                                                {
                                                    <span>🥉</span>
                                                }
                                            </td>

                                            <td class="player-cell">
                                                @player.DisplayName

                                                @if (player.UserIcon == UserIcon.EarlyBacker)
                                                {
                                                    <img src="~/img/pig.webp"
                                                         style="height: 30px; width: 30px;" />
                                                }
                                                else if (player.UserIcon == UserIcon.CoolGuy)
                                                {
                                                    <img src="~/img/logo-cool.png"
                                                         style="height: 30px; width: 30px;" />
                                                }
                                                else if (player.UserIcon == UserIcon.Dweeb)
                                                {
                                                    <img src="~/img/logo.png"
                                                         style="height: 30px; width: 30px;" />
                                                }
                                            </td>

                                            <td>
                                                <strong>@player.TotalWins</strong>
                                            </td>

                                            <td>
                                                <i class="bi bi-fire"
                                                   style="color: #e99b43;"></i>
                                                @player.LongestStreak days
                                            </td>

                                            <td>
                                                @player.AverageMistakes.ToString("0.0")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }


        <div class="leaderboard-footer">
            <div>
                <a asp-page="/Dweeble/Leaderboard">
                    <i class="bi bi-arrow-right"></i>
                    To Daily Leaderboard
                </a>
            </div>
            
            <div>
                <a asp-page="/Dweeble/Index">
                    <i class="bi bi-arrow-left"></i>
                    To Dweeble
                </a>
            </div>
        </div>

    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/dweeble/leaderboard.css" asp-append-version="true" />
}