@model Models.CardViewModel

@{
    var cardImage = Model.Card.GetOptimizedImage;

    if (Model.CardImageType == CardImageTypeEnum.XSmall)
        cardImage = Model.Card.GetExtraSmallImage;
    else if (Model.CardImageType == CardImageTypeEnum.Small)
        cardImage = Model.Card.GetSmallImage;
    else if (Model.CardImageType == CardImageTypeEnum.Large)
        cardImage = Model.Card.GetLargeImage;

    var customCardStyle = Model.Card.IsCustomCard ? "display: none;" : "";
    var cardSets = Model.Card.CardSets;
    var cardSetText = "";
    if (cardSets != null)
    {
        cardSetText = string.Join(",", Model.Card.CardSets.Select(x => $"#{x.Id}#"));
    }
}

<div style="width: 120px; @customCardStyle"
     class="card-container"
     data-id="@Model.Card.Id"
     data-custom="@Model.Card.IsCustomCard"
     data-card-image="@(Model.BaseUrl + cardImage)"
     data-card-type="@Model.Card.TypeId"
     data-landscape="@(Model.Card.LandscapeId)"
     data-name="@Model.Card.Name"
     data-ability="@Model.Card.Ability"
     data-cost="@(Model.Card.Cost.HasValue ? Model.Card.Cost.ToString() : "")"
     data-set="@(cardSetText)"
     data-attack="@(Model.Card.Attack.HasValue ? Model.Card.Attack.ToString() : "")"
     data-defense="@(Model.Card.Defense.HasValue ? Model.Card.Defense.ToString() : "")">
    <div class="card-image">
        <img data-src="@(Model.BaseUrl + cardImage)"
             alt="@Model.Card.Name"
             class="lazy-image w-100"
             loading="lazy" />
        @if (Model.IsAddable)
        {
            <div class="card-overlay add"></div>
        }
        @if (Model.IsDeleteable)
        {
            <div class="card-overlay remove"></div>
        }
    </div>
</div>