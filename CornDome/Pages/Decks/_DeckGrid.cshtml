@model DeckGridViewModel

<div class="row g-4">
    @foreach (var deck in Model.Decks)
    {
        var iconCard = Model.Cards.FirstOrDefault(x => x.Id == deck.IconCardId);
        <div class="col-12 col-md-6 col-xl-4">
            <div class="deck-card h-100 shadow-sm">

                <a class="text-decoration-none"
                   asp-page="/Deck"
                   asp-route-id="@deck.Id">

                    <div class="card-body card-body-image"
                         style="background-image: url('@(Model.BaseUrl + iconCard.LatestRevision.GetRegularImage)');">
                    </div>
                </a>

                <div class="card-footer bg-transparent border-top-0">
                    <h5 class="card-title mb-2 text-muted">
                        @deck.Description
                    </h5>

                    <div class="row">
                        <div class="col-6">
                            <div class="small text-muted">
                                <a asp-page="/Decks/User"
                                   asp-route-userId="@deck.UserId">
                                    @deck.User.UserName
                                </a>
                            </div>
                        </div>

                        @if (deck.UserId == Model.UserId)
                        {
                            <div class="col-6 text-end">
                                <button class="btn btn-danger">Delete</button>
                            </div>
                        }
                        else
                        {
                            <div class="col-6">
                                <div class="small text-muted text-end">
                                    <strong>Modified:</strong>
                                    @deck.Modified.ToString("MM/dd/yyyy")
                                </div>
                            </div>
                        }
                        
                    </div>
                </div>

            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Deck pagination">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                <a class="page-link"
                   href="?page=@(Model.PageNumber - 1)">
                    Previous
                </a>
            </li>

            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       href="?page=@i">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   href="?page=@(Model.PageNumber + 1)">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}

<style>
    .deck-card {
        position: relative;
        display: flex;
        flex-direction: column;
        min-width: 0;
        word-wrap: break-word;
        background-color: #fff;
        background-clip: border-box;
        border-radius: .25rem;
    }

    .card-body {
        border: 4px solid rgba(0,0,0,.125);
    }

        .card-body:hover {
            border: 4px solid orange;
        }

    .card-body-image {
        height: 200px;
        background-repeat: no-repeat;
        background-size: 484px;
        background-position-x: -50px;
        background-position-y: -100px;
        position: relative;
    }

    .card-body-image::after {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, .25);
        pointer-events: none;
    }
</style>